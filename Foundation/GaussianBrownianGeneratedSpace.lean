import Foundation.GaussianDeterministicIntegral

/-! The correct Brownian-generated scalar domain and the proved direction of
predictable representation. Closedness of the integral range is not surjectivity. -/
noncomputable section
open MeasureTheory Set
open scoped ENNReal NNReal Topology
namespace OperatorDerivativeRewrite.Foundation.GaussianBrownianGeneratedSpace
open InfiniteGaussian GaussianTimeHilbert GaussianTimeProcess GaussianTimeDivergence
open GaussianTimeProductL2 GaussianPredictableFull GaussianPredictableL2Completion
open GaussianContinuousRigidity GaussianSensitivityCore SeparableHilbertEmbedding
attribute [local instance] timeHilbert_secondCountable
local instance : CompleteSpace fullPredictable := fullPredictable_isClosed.completeSpace_coe

/-- Generated by ALL nonnegative-time Brownian observations, not ambient Gaussian coordinates. -/
@[instance_reducible] def brownianSigma : MeasurableSpace SampleSpace :=
  MeasurableSpace.comap (fun ω t => process t ω) inferInstance

theorem brownianSigma_le : brownianSigma ≤ (inferInstance : MeasurableSpace SampleSpace) :=
  (Measurable.of_eval (fun t => (process_stronglyMeasurable t).measurable)).comap_le

def brownianL2 : Submodule ℝ GaussianL2 := lpMeas ℝ ℝ brownianSigma 2 gaussianProduct

theorem brownianL2_isClosed : IsClosed (brownianL2 : Set GaussianL2) :=
  isClosed_aestronglyMeasurable brownianSigma_le

def centeredBrownianL2 : Submodule ℝ GaussianL2 :=
  brownianL2 ⊓ (innerSL ℝ gaussianOne).ker

theorem mem_centeredBrownianL2_iff (f : GaussianL2) : f ∈ centeredBrownianL2 ↔
    AEStronglyMeasurable[brownianSigma] f gaussianProduct ∧
      (∫ ω, f ω ∂gaussianProduct) = 0 := by
  change (_ ∧ inner ℝ gaussianOne f = 0) ↔ _
  rw [gaussianOne_inner_eq_integral]
  rfl

theorem centeredBrownianL2_isClosed : IsClosed (centeredBrownianL2 : Set GaussianL2) :=
  brownianL2_isClosed.inter (innerSL ℝ gaussianOne).isClosed_ker

def brownianPolynomial : MvPolynomial ℝ≥0 ℝ →ₗ[ℝ] GaussianL2 :=
  familyPolynomialEmbedding (fun t => hilbertEmbedding TimeHilbert (timeVector t))

/-- Arbitrary finite observation polynomials are genuinely dense in the entire generated space. -/
theorem brownianPolynomial_closure : brownianPolynomial.range.topologicalClosure = brownianL2 :=
  familyPolynomial_closure _

theorem process_brownian_measurable (t : ℝ≥0) : Measurable[brownianSigma] (process t) := by
  letI : MeasurableSpace SampleSpace := brownianSigma
  have hm : Measurable (fun ω s => process s ω) := Measurable.of_comap_le le_rfl
  exact (measurable_pi_apply t).comp hm

theorem incrementProduct_mem_brownianL2 {ι : Type*} [Fintype ι]
    (r : ι → ℝ≥0) (p : MvPolynomial ι ℝ) (s t : ℝ≥0) :
    incrementProductL2 r p s t ∈ brownianL2 := by
  have hm : Measurable[brownianSigma] (fun ω => MvPolynomial.eval (fun i => process (r i) ω) p *
      (process t ω - process s ω)) := by
    letI : MeasurableSpace SampleSpace := brownianSigma
    exact (p.continuous_eval.measurable.comp
      (Measurable.of_eval fun i => process_brownian_measurable (r i))).mul
        ((process_brownian_measurable t).sub (process_brownian_measurable s))
  exact hm.stronglyMeasurable.aestronglyMeasurable.congr (incrementProductL2_coeFn r p s t).symm

/-- The full predictable integral takes values in the correct generated scalar space. -/
theorem itoIntegral_mem_brownianL2 (u : fullPredictable) : itoIntegral u ∈ brownianL2 := by
  have h : closedProductSteps ≤ brownianL2.comap integralExtension.toLinearMap := by
    apply Submodule.topologicalClosure_minimal
    · rw [productStepSpan, Submodule.map_le_iff_le_comap]
      apply Submodule.span_le.mpr
      rintro z ⟨n, r, p, s, t, hrs, hst, rfl⟩
      change integralExtension (pastStep s t r hrs p) ∈ brownianL2
      rw [integralExtension_eq, ito_pastStep s t hst]
      exact incrementProduct_mem_brownianL2 r p s t
    · exact brownianL2_isClosed.preimage integralExtension.continuous
  have hu' : (u : TimeProbabilityL2) ∈ closedProductSteps := by
    rw [closedProductSteps_eq_fullPredictable]
    exact u.property
  have hu := h hu'
  change integralExtension u ∈ brownianL2 at hu
  rwa [integralExtension_eq] at hu

theorem itoIntegral_mem_centeredBrownianL2 (u : fullPredictable) :
    itoIntegral u ∈ centeredBrownianL2 :=
  (mem_centeredBrownianL2_iff _).mpr ⟨itoIntegral_mem_brownianL2 u, itoIntegral_centered u⟩

theorem integralRange_le_centeredBrownianL2 :
    itoIntegral.toLinearMap.range ≤ centeredBrownianL2 := by
  rintro f ⟨u, rfl⟩
  exact itoIntegral_mem_centeredBrownianL2 u

theorem integralRange_isClosed : IsClosed (itoIntegral.toLinearMap.range : Set GaussianL2) :=
  itoIntegral.isometry.isClosedEmbedding.isClosed_range

/-- Uniqueness uses the genuine isometry and requires no PRP assumption. -/
theorem integral_representation_unique (u v : fullPredictable)
    (h : itoIntegral u = itoIntegral v) : u = v := itoIntegral.injective h

end OperatorDerivativeRewrite.Foundation.GaussianBrownianGeneratedSpace
