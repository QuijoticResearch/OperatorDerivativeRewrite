import Foundation.IBMContinuousComposition
import Mathlib.MeasureTheory.Function.ConditionalExpectation.CondexpL2

/-! Observable L² and conditional expectation for the conditional IBM
composition of supplied continuous source paths. -/
noncomputable section
open MeasureTheory
open scoped NNReal ENNReal

namespace OperatorDerivativeRewrite.Foundation.IBMConditionalObservable
open IBMSourceLaws IBMContinuousComposition InfiniteGaussian

variable (X : SampleSpace → C(ℝ, ℝ)) (Y : SampleSpace → C(ℝ≥0, ℝ))

/-- Sigma-algebra generated by all random-time composition coordinates. -/
@[instance_reducible] def observableSigma : MeasurableSpace JointSample :=
  MeasurableSpace.comap (fun w : JointSample => fun t : ℝ≥0 => value X Y t w) inferInstance

/-- The closed candidate observable subspace, defined independently of
source-derivative domain membership. -/
def observableSpace : Submodule ℝ (Lp ℝ 2 jointMeasure) :=
  lpMeas ℝ ℝ (observableSigma X Y) 2 jointMeasure

/-- Measurability of supplied continuous source paths makes the generated
sigma-algebra a sub-sigma-algebra of the ambient product space. -/
theorem observableSigma_le (hX : Measurable X) (hY : Measurable Y) :
    observableSigma X Y ≤ (inferInstance : MeasurableSpace JointSample) :=
  (Measurable.of_eval (value_measurable X Y hX hY)).comap_le

/-- The conditional IBM observable L² subspace is closed. -/
theorem observableSpace_isClosed (hX : Measurable X) (hY : Measurable Y) :
    IsClosed (observableSpace X Y : Set (Lp ℝ 2 jointMeasure)) := by
  change IsClosed {f : Lp ℝ 2 jointMeasure |
    AEStronglyMeasurable[observableSigma X Y] f jointMeasure}
  exact isClosed_aestronglyMeasurable (observableSigma_le X Y hX hY)

/-- Conditional expectation onto the supplied random-time observable
sigma-algebra, valued in its own L² subspace. -/
def observableProjection (hX : Measurable X) (hY : Measurable Y) :
    Lp ℝ 2 jointMeasure →L[ℝ] observableSpace X Y :=
  condExpL2 ℝ ℝ (observableSigma_le X Y hX hY)

/-- Conditional expectation is contractive as a map into observable L². -/
theorem observableProjection_norm_le (hX : Measurable X) (hY : Measurable Y)
    (f : Lp ℝ 2 jointMeasure) :
    ‖observableProjection X Y hX hY f‖ ≤ ‖f‖ :=
  norm_condExpL2_le (observableSigma_le X Y hX hY) f

end OperatorDerivativeRewrite.Foundation.IBMConditionalObservable

