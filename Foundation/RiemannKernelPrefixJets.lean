def piBox30 (p : ℕ) : Box :=
  range (3141592653589793238462643383279/1000000000000000000000000000000) (39269908169872415480783042291/12500000000000000000000000000) p

theorem pi_mem30 (p : ℕ) : Real.pi∈piBox30 p :=
  by
    apply range_mem
    · convert pi_lower30.le using 1; norm_num
    · convert pi_upper30.le using 1; norm_num


/-- The actual ZERO-quartic theta phase; no fixed time8 term is present. -/
def thetaPhase (m : ℕ) (a u : ℝ) : ℝ :=
  a*u^1-Real.pi*(m:ℝ)^2*Real.exp (4*u)

theorem thetaPhase_contDiff (m : ℕ) (a : ℝ) : ContDiff ℝ ∞ (thetaPhase m a) := by
  unfold thetaPhase
  fun_prop

theorem thetaPhase_coefficient (m n : ℕ) (a u : ℝ) :
    RiemannQuarticTaylorJets.coefficient (thetaPhase m a) n u=
      (a*((1:ℕ).descFactorial n:ℝ)*u^(1-n)-
        Real.pi*(m:ℝ)^2*4^n*Real.exp (4*u))/(n.factorial:ℝ) := by
  unfold RiemannQuarticTaylorJets.coefficient thetaPhase
  rw [iteratedDeriv_fun_sub (by fun_prop) (by fun_prop)]
  simp only [iteratedDeriv_const_mul_field,iteratedDeriv_pow,iteratedDeriv_exp_const_mul]
  ring

def thetaPhaseJet (U E P A : Box) (m p n : ℕ) : Box :=
  divNat (sub
    (mul A (mul (rational ((1:ℕ).descFactorial n:ℚ) p) (pow U p (1-n)) p) p)
    (mul (mul P (rational ((m:ℚ)^2) p) p)
      (mul (rational ((4:ℚ)^n) p) E p) p) p) n.factorial p

theorem thetaPhaseJet_mem {u a : ℝ} {U E P A : Box}
    (hu : u∈U) (he : Real.exp (4*u)∈E) (hp : Real.pi∈P) (ha : a∈A)
    (m p n : ℕ) :
    RiemannQuarticTaylorJets.coefficient (thetaPhase m a) n u∈thetaPhaseJet U E P A m p n := by
  rw [thetaPhase_coefficient]
  have hd : ((1:ℕ).descFactorial n:ℝ)∈rational ((1:ℕ).descFactorial n:ℚ) p := by
    simpa only [Rat.cast_natCast] using rational_mem ((1:ℕ).descFactorial n:ℚ) p
  have hm : (m:ℝ)^2∈rational ((m:ℚ)^2) p := by

    have h := rational_mem ((m:ℚ)^2) p
    have e : (((m:ℚ)^2:ℚ):ℝ)=(m:ℝ)^2 := by norm_cast
    rw [e] at h
    exact h
  have h4 : (4:ℝ)^n∈rational ((4:ℚ)^n) p := by
    simpa only [Rat.cast_pow,Rat.cast_ofNat] using rational_mem ((4:ℚ)^n) p
  simpa only [mul_assoc,thetaPhaseJet] using divNat_mem (sub_mem (mul_mem ha (mul_mem hd (pow_mem hu p (1-n)) p) p)
    (mul_mem (mul_mem hp hm p) (mul_mem h4 he p) p) p) n.factorial p

def thetaExpJet (U E P A B : Box) (m p n : ℕ) : Box :=
  expJetStored (thetaPhaseJet U E P A m p) B p n

theorem thetaExpJet_mem {u a : ℝ} {U E P A B : Box}
    (hu : u∈U) (he : Real.exp (4*u)∈E) (hp : Real.pi∈P) (ha : a∈A)
    (m p n : ℕ) (hb : Real.exp (thetaPhase m a u)∈B) :
    RiemannQuarticTaylorJets.coefficient (fun v => Real.exp (thetaPhase m a v)) n u∈
      thetaExpJet U E P A B m p n := by
  exact expJetStored_mem (thetaPhase m a) (thetaPhase_contDiff m a) u
    (thetaPhaseJet U E P A m p) B p n hb (fun i hi => thetaPhaseJet_mem hu he hp ha m p i)

theorem partialKernel_sum (N : ℕ) (u : ℝ) :
    RiemannThetaTruncation.partialKernel N u=
      ∑ j ∈ Finset.range N,
        (2*Real.pi^2*(((j:ℕ):ℝ)+1)^4*Real.exp (thetaPhase (j+1) 9 u)-
        3*Real.pi*(((j:ℕ):ℝ)+1)^2*Real.exp (thetaPhase (j+1) 5 u)) := by
  unfold RiemannThetaTruncation.partialKernel RiemannThetaTruncation.thetaPrefix RiemannQuarticKernel.thetaTerm
  rw [Finset.mul_sum,Finset.mul_sum,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [thetaPhase,Nat.cast_add,Nat.cast_one,pow_one,sub_eq_add_neg,Real.exp_add]
  ring

theorem partialKernel_coefficient (N n : ℕ) (u : ℝ) :
    RiemannQuarticTaylorJets.coefficient (RiemannThetaTruncation.partialKernel N) n u=
      ∑ j ∈ Finset.range N,
        (2*Real.pi^2*(((j:ℕ):ℝ)+1)^4*
          RiemannQuarticTaylorJets.coefficient (fun v => Real.exp (thetaPhase (j+1) 9 v)) n u-
        3*Real.pi*(((j:ℕ):ℝ)+1)^2*
          RiemannQuarticTaylorJets.coefficient (fun v => Real.exp (thetaPhase (j+1) 5 v)) n u) := by
  have he : RiemannThetaTruncation.partialKernel N=(fun u => ∑ j ∈ Finset.range N,
    (2*Real.pi^2*(((j:ℕ):ℝ)+1)^4*Real.exp (thetaPhase (j+1) 9 u)-
    3*Real.pi*(((j:ℕ):ℝ)+1)^2*Real.exp (thetaPhase (j+1) 5 u))) := funext (partialKernel_sum N)
  unfold RiemannQuarticTaylorJets.coefficient
  rw [he,iteratedDeriv_fun_sum (fun j hj => by fun_prop [thetaPhase]),Finset.sum_div]
  apply Finset.sum_congr rfl
  intro j hj
  rw [iteratedDeriv_fun_sub (by fun_prop [thetaPhase]) (by fun_prop [thetaPhase]),
    iteratedDeriv_const_mul_field,iteratedDeriv_const_mul_field]
  ring

open RiemannQuarticTaylorJets

/-- Exact evaluation point in the ORIGINAL u coordinate. -/
def pointU (p : ℕ) : Box := rational (1/32) p

def pointE (p : ℕ) : Box := scaledExpHorner (rational (1/8) p) p 80 0

def pointPhase (m : ℕ) (a : ℚ) (p : ℕ) : Box :=
  thetaPhaseJet (pointU p) (pointE p) (piBox30 p) (rational a p) m p 0

def pointBase (m : ℕ) (a : ℚ) (p : ℕ) : Box :=
  scaledExpHorner (pointPhase m a p) p 80 12

def pointExpJet (m : ℕ) (a : ℚ) (p n : ℕ) : Box :=
  thetaExpJet (pointU p) (pointE p) (piBox30 p) (rational a p) (pointBase m a p) m p n

private theorem point_inputs (p : ℕ) :
    (1/32:ℝ)∈pointU p ∧ Real.exp (4*(1/32:ℝ))∈pointE p := by
  constructor
  · simpa only [pointU,Rat.cast_div,Rat.cast_one,Rat.cast_ofNat] using rational_mem (1/32) p
  · have h : (1/8:ℝ)∈rational (1/8) p := by
      simpa only [Rat.cast_div,Rat.cast_one,Rat.cast_ofNat] using rational_mem (1/8) p
    simpa only [show (4:ℝ)*(1/32)=1/8 from by norm_num,pointE] using
      scaledExpHorner_mem h p 80 0 (by norm_num) (by norm_num)

private theorem thetaPhase_scaled (m : ℕ) (hm : m≤16) (a : ℚ) (ha0 : 0≤a) (ha9 : a≤9) :
    |thetaPhase m (a:ℝ) (1/32)/((2^12:ℕ):ℝ)|≤1 := by
  have ha0' : (0:ℝ)≤a := by exact_mod_cast ha0
  have ha9' : (a:ℝ)≤9 := by exact_mod_cast ha9
  have hm' : (m:ℝ)≤16 := by exact_mod_cast hm
  have hm0 : (0:ℝ)≤m := Nat.cast_nonneg m
  have hm2 : (m:ℝ)^2≤256 := by nlinarith
  have he : Real.exp (4*(1/32:ℝ))≤3 :=
    (Real.exp_le_exp.mpr (by norm_num : (4:ℝ)*(1/32)≤1)).trans Real.exp_one_lt_three.le
  have hprod := mul_le_mul (mul_le_mul Real.pi_lt_four.le hm2 (sq_nonneg _) (by norm_num : (0:ℝ)≤4)) he
    (Real.exp_pos _).le (by norm_num : (0:ℝ)≤4*256)
  have hp0 : (0:ℝ)≤Real.pi*(m:ℝ)^2*Real.exp (4*(1/32:ℝ)) := by positivity
  rw [abs_div,abs_of_pos (by positivity : (0:ℝ)<((2^12:ℕ):ℝ))]
  apply (div_le_iff₀ (by positivity : (0:ℝ)<((2^12:ℕ):ℝ))).mpr
  rw [abs_le]
  norm_num only [Nat.cast_pow,Nat.cast_ofNat,pow_one,one_mul,thetaPhase]
  constructor <;> nlinarith

/-- Sound concrete exponential jets at1/32 for every needed theta term. -/
theorem pointExpJet_mem (m : ℕ) (hm : m≤16) (a : ℚ) (ha0 : 0≤a) (ha9 : a≤9) (p n : ℕ) :
    coefficient (fun u => Real.exp (thetaPhase m (a:ℝ) u)) n (1/32)∈pointExpJet m a p n := by
  obtain ⟨hu,he⟩ := point_inputs p
  have hp := pi_mem30 p
  have ha := rational_mem a p
  have hf : thetaPhase m (a:ℝ) (1/32)∈pointPhase m a p := by
    simpa only [pointPhase,coefficient_zero] using thetaPhaseJet_mem hu he hp ha m p 0
  have hb : Real.exp (thetaPhase m (a:ℝ) (1/32))∈pointBase m a p :=
    scaledExpHorner_mem hf p 80 12 (by norm_num) (thetaPhase_scaled m hm a ha0 ha9)
  exact thetaExpJet_mem hu he hp ha m p n hb

def weightNine (m p : ℕ) : Box :=
  mul (mul (rational 2 p) (pow (piBox30 p) p 2) p) (rational ((m:ℚ)^4) p) p

def weightFive (m p : ℕ) : Box :=
  mul (mul (rational 3 p) (piBox30 p) p) (rational ((m:ℚ)^2) p) p

private theorem weightNine_mem (m p : ℕ) : 2*Real.pi^2*(m:ℝ)^4∈weightNine m p := by
  have hm : (m:ℝ)^4∈rational ((m:ℚ)^4) p := by
    have h := rational_mem ((m:ℚ)^4) p
    have e : (((m:ℚ)^4:ℚ):ℝ)=(m:ℝ)^4 := by norm_cast
    rw [e] at h
    exact h
  exact mul_mem (mul_mem (by simpa using rational_mem 2 p) (pow_mem (pi_mem30 p) p 2) p) hm p

private theorem weightFive_mem (m p : ℕ) : 3*Real.pi*(m:ℝ)^2∈weightFive m p := by
  have hm : (m:ℝ)^2∈rational ((m:ℚ)^2) p := by
    have h := rational_mem ((m:ℚ)^2) p
    have e : (((m:ℚ)^2:ℚ):ℝ)=(m:ℝ)^2 := by norm_cast
    rw [e] at h
    exact h
  exact mul_mem (mul_mem (by simpa using rational_mem 3 p) (pi_mem30 p) p) hm p

def pointPrefixJet (p n : ℕ) : Box :=
  sum (fun j => sub
    (mul (weightNine (j+1) p) (pointExpJet (j+1) 9 p n) p)
    (mul (weightFive (j+1) p) (pointExpJet (j+1) 5 p n) p) p) p 16

theorem pointPrefixJet_mem (p n : ℕ) :
    coefficient (RiemannThetaTruncation.partialKernel 16) n (1/32)∈pointPrefixJet p n := by
  rw [partialKernel_coefficient]
  apply RiemannQuarticDyadic.sum_mem
  intro j hj
  have hm : j+1≤16 := by omega
  have h9 := pointExpJet_mem (j+1) hm 9 (by norm_num) (by norm_num) p n
  have h5 := pointExpJet_mem (j+1) hm 5 (by norm_num) (by norm_num) p n
  simpa only [Nat.cast_add,Nat.cast_one,Rat.cast_ofNat] using
    sub_mem (mul_mem (weightNine_mem (j+1) p) h9 p) (mul_mem (weightFive_mem (j+1) p) h5 p) p

/-- Infinite actual kernel coefficient enclosure with the PROVED tail error. -/
def pointKernelJet (p n : ℕ) : Box :=
  add (pointPrefixJet p n) (range (-1/(10:ℚ)^100) (1/(10:ℚ)^100) p) p

theorem pointKernelJet_mem (p n : ℕ) (hn : n≤10) :
    coefficient RiemannQuarticKernel.kernel n (1/32)∈pointKernelJet p n := by
  have h := abs_lt.mp (RiemannKernelTailJets.real_sixteen_coefficient_error n hn)
  have he : coefficient RiemannQuarticKernel.kernel n (1/32)-
      coefficient (RiemannThetaTruncation.partialKernel 16) n (1/32)∈
      range (-1/(10:ℚ)^100) (1/(10:ℚ)^100) p := by
    apply range_mem
    · convert h.1.le using 1; norm_num
    · convert h.2.le using 1; norm_num
  have ha := add_mem (pointPrefixJet_mem p n) he p
  rw [show coefficient RiemannQuarticKernel.kernel n (1/32)=
    coefficient (RiemannThetaTruncation.partialKernel 16) n (1/32)+
    (coefficient RiemannQuarticKernel.kernel n (1/32)-
    coefficient (RiemannThetaTruncation.partialKernel 16) n (1/32)) from by ring]
  exact ha

end OperatorDerivativeRewrite.Foundation.RiemannKernelPrefixJets
