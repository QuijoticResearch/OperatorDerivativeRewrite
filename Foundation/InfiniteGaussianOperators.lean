import Foundation.InfiniteGaussianIBP
import Foundation.AdjointClosure

/-! Genuine cylindrical divergence, closability, graph closure, and Hilbert adjoint. -/
noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal Topology
namespace OperatorDerivativeRewrite.Foundation.InfiniteGaussian
set_option backward.isDefEq.respectTransparency false

/-- D₀ as a partial linear operator on the ambient scalar L² space. -/
def cylindricalDerivative : GaussianL2 →ₗ.[ℝ] GaussianVectorL2 where
  domain := polynomialCylindricalDomain
  toFun := polynomialDerivative

/-- The algebraic graph generated by genuine rank-one fields and their explicit divergences. -/
def cylindricalDivergenceGraph : Submodule ℝ (GaussianVectorL2 × GaussianL2) :=
  Submodule.span ℝ {z | ∃ (g : polynomialCylindricalDomain) (h : CoefficientSpace),
    (scalarTensor h g, rankDivergence g h) = z}

/-- The proved rank-one IBP extends linearly to the entire generated graph. -/
theorem cylindricalDivergenceGraph_pairing (f : polynomialCylindricalDomain)
    (z : GaussianVectorL2 × GaussianL2) (hz : z ∈ cylindricalDivergenceGraph) :
    inner ℝ (polynomialDerivative f) z.1 = inner ℝ (f : GaussianL2) z.2 := by
  let L : (GaussianVectorL2 × GaussianL2) →ₗ[ℝ] ℝ :=
    (innerSL ℝ (polynomialDerivative f)).toLinearMap.comp (LinearMap.fst ℝ _ _) -
      (innerSL ℝ (f : GaussianL2)).toLinearMap.comp (LinearMap.snd ℝ _ _)
  have hs : cylindricalDivergenceGraph ≤ L.ker := by
    apply Submodule.span_le.mpr
    rintro z ⟨g, h, rfl⟩
    apply LinearMap.mem_ker.mpr
    exact sub_eq_zero.mpr (polynomialDerivative_rank_pairing f g h)
  exact sub_eq_zero.mp (LinearMap.mem_ker.mp (hs hz))

/-- Scalar density and IBP prove single-valuedness; no divergence independence is assumed. -/
theorem cylindricalDivergenceGraph_vertical_zero (z : GaussianVectorL2 × GaussianL2)
    (hz : z ∈ cylindricalDivergenceGraph) (hzero : z.1 = 0) : z.2 = 0 := by
  have he : (fun f : GaussianL2 => inner ℝ f z.2) = fun _ => (0 : ℝ) := by
    apply Continuous.ext_on polynomialCylindricalDomain_dense
      (continuous_id.inner continuous_const) continuous_const
    intro f hf
    have hp := cylindricalDivergenceGraph_pairing ⟨f, hf⟩ z hz
    rw [hzero, inner_zero_right] at hp
    exact hp.symm
  exact inner_self_eq_zero.mp (congrFun he z.2)

/-- The genuine finite-rank polynomial cylindrical divergence,
obtained from its single-valued graph. -/
def cylindricalDivergence : GaussianVectorL2 →ₗ.[ℝ] GaussianL2 :=
  cylindricalDivergenceGraph.toLinearPMap

theorem cylindricalDivergence_graph : cylindricalDivergence.graph = cylindricalDivergenceGraph :=
  cylindricalDivergenceGraph.toLinearPMap_graph_eq cylindricalDivergenceGraph_vertical_zero

theorem cylindricalDivergence_rank_graph (g : polynomialCylindricalDomain) (h : CoefficientSpace) :
    (scalarTensor h g, rankDivergence g h) ∈ cylindricalDivergence.graph := by
  rw [cylindricalDivergence_graph]
  exact Submodule.subset_span ⟨g, h, rfl⟩

/-- δ₀ has exactly the finite-rank polynomial vector domain, with no graph-closure assumption. -/
theorem cylindricalDivergence_domain : cylindricalDivergence.domain = cylindricalVectorDomain := by
  apply le_antisymm
  · have hs : cylindricalDivergenceGraph ≤
        cylindricalVectorDomain.comap (LinearMap.fst ℝ GaussianVectorL2 GaussianL2) := by
      apply Submodule.span_le.mpr
      rintro z ⟨g, h, rfl⟩
      exact scalarTensor_mem_domain g h
    intro u hu
    have hg := cylindricalDivergence.mem_graph ⟨u, hu⟩
    rw [cylindricalDivergence_graph] at hg
    exact hs hg
  · apply Submodule.span_le.mpr
    rintro u ⟨g, h, rfl⟩
    exact LinearPMap.mem_domain_iff.mpr ⟨rankDivergence g h, cylindricalDivergence_rank_graph g h⟩

theorem cylindricalDerivative_dense_domain :
    Dense (cylindricalDerivative.domain : Set GaussianL2) := polynomialCylindricalDomain_dense

theorem cylindricalDivergence_dense_domain :
    Dense (cylindricalDivergence.domain : Set GaussianVectorL2) := by
  rw [cylindricalDivergence_domain]
  exact cylindricalVectorDomain_dense

/-- Integration by parts for the actual two cylindrical operator domains. -/
theorem cylindricalDerivative_formalAdjoint :
    cylindricalDerivative.IsFormalAdjoint cylindricalDivergence := by
  intro f u
  have hg := cylindricalDivergence.mem_graph u
  rw [cylindricalDivergence_graph] at hg
  exact cylindricalDivergenceGraph_pairing f _ hg

/-- D₀ is contained in the closed adjoint of the genuinely dense test-field divergence. -/
theorem cylindricalDerivative_le_divergence_adjoint :
    cylindricalDerivative ≤ cylindricalDivergence.adjoint :=
  cylindricalDerivative_formalAdjoint.symm.le_adjoint cylindricalDivergence_dense_domain

/-- δ₀ is contained in the adjoint of D₀, including domain membership and values. -/
theorem cylindricalDivergence_le_derivative_adjoint :
    cylindricalDivergence ≤ cylindricalDerivative.adjoint :=
  cylindricalDerivative_formalAdjoint.le_adjoint cylindricalDerivative_dense_domain

/-- Genuine closability of D₀ follows from IBP and proved vector test-field density. -/
theorem cylindricalDerivative_isClosable : cylindricalDerivative.IsClosable :=
  (cylindricalDivergence.adjoint_isClosed cylindricalDivergence_dense_domain).isClosable
    |>.leIsClosable
    cylindricalDerivative_le_divergence_adjoint

/-- The cylindrical divergence is also closable; no equality with the full adjoint is inferred. -/
theorem cylindricalDivergence_isClosable : cylindricalDivergence.IsClosable :=
  (cylindricalDerivative.adjoint_isClosed cylindricalDerivative_dense_domain).isClosable
    |>.leIsClosable
    cylindricalDivergence_le_derivative_adjoint

/-- D is exactly the graph closure of the genuine polynomial derivative D₀. -/
abbrev closedCylindricalDerivative := cylindricalDerivative.closure

/-- The full Hilbert divergence is δ = D*, with its natural adjoint domain. -/
abbrev hilbertDivergence := closedCylindricalDerivative.adjoint

theorem closedCylindricalDerivative_isClosed : closedCylindricalDerivative.IsClosed :=
  cylindricalDerivative_isClosable.closure_isClosed

theorem closedCylindricalDerivative_dense_domain :
    Dense (closedCylindricalDerivative.domain : Set GaussianL2) :=
  operatorClosure_dense_domain cylindricalDerivative_dense_domain

/-- Exact graph characterization of D, rather than an assumed Sobolev domain. -/
theorem closedCylindricalDerivative_graph :
    closedCylindricalDerivative.graph = cylindricalDerivative.graph.topologicalClosure :=
  cylindricalDerivative_isClosable.graph_closure_eq_closure_graph.symm

theorem closedCylindricalDerivative_mem_iff (f : GaussianL2) :
    f ∈ closedCylindricalDerivative.domain ↔
      ∃ v : GaussianVectorL2, (f, v) ∈ cylindricalDerivative.graph.topologicalClosure := by
  rw [← closedCylindricalDerivative_graph]
  exact LinearPMap.mem_domain_iff

/-- Closing D₀ preserves its Hilbert adjoint. -/
theorem hilbertDivergence_eq_cylindricalDerivative_adjoint :
    hilbertDivergence = cylindricalDerivative.adjoint :=
  operatorClosure_adjoint_eq cylindricalDerivative_isClosable cylindricalDerivative_dense_domain

/-- δ₀ ⊆ δ is a proved inclusion; full adjoint identification is not asserted. -/
theorem cylindricalDivergence_le_hilbertDivergence : cylindricalDivergence ≤ hilbertDivergence := by
  rw [hilbertDivergence_eq_cylindricalDerivative_adjoint]
  exact cylindricalDivergence_le_derivative_adjoint

theorem hilbertDivergence_isClosed : hilbertDivergence.IsClosed :=
  closedCylindricalDerivative.adjoint_isClosed closedCylindricalDerivative_dense_domain

theorem hilbertDivergence_dense_domain :
    Dense (hilbertDivergence.domain : Set GaussianVectorL2) :=
  cylindricalDivergence_dense_domain.mono cylindricalDivergence_le_hilbertDivergence.1

/-- The full adjoint domain is exactly the fields admitting an L² weak divergence. -/
theorem hilbertDivergence_mem_iff (u : GaussianVectorL2) :
    u ∈ hilbertDivergence.domain ↔ ∃ v : GaussianL2,
      ∀ f : closedCylindricalDerivative.domain,
        inner ℝ (closedCylindricalDerivative f) u = inner ℝ (f : GaussianL2) v := by
  constructor
  · intro hu
    exact ⟨hilbertDivergence ⟨u, hu⟩, fun f =>
      (closedCylindricalDerivative.adjoint_isFormalAdjoint
        closedCylindricalDerivative_dense_domain).symm f ⟨u, hu⟩⟩
  · rintro ⟨v, hv⟩
    apply LinearPMap.mem_adjoint_domain_of_exists
    refine ⟨v, fun f => ?_⟩
    calc
      inner ℝ v (f : GaussianL2) = inner ℝ (f : GaussianL2) v := real_inner_comm _ _
      _ = inner ℝ (closedCylindricalDerivative f) u := (hv f).symm
      _ = inner ℝ u (closedCylindricalDerivative f) := real_inner_comm _ _


/-- An actual finite-rank polynomial field, represented as a finite sum of Gⱼ hⱼ. -/
def cylindricalField {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace) : GaussianVectorL2 :=
  ∑ i, scalarTensor (h i) (g i)

/-- The explicit finite-sum divergence expression, before any comparison of decompositions. -/
def cylindricalDivergenceExpression {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace) : GaussianL2 :=
  ∑ i, rankDivergence (g i) (h i)

theorem cylindricalDivergence_field_graph {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace) :
    (cylindricalField g h, cylindricalDivergenceExpression g h) ∈ cylindricalDivergence.graph := by
  have hs := cylindricalDivergence.graph.sum_mem (t := Finset.univ)
    (fun i _ => cylindricalDivergence_rank_graph (g i) (h i))
  convert hs using 1
  exact prod_mk_sum Finset.univ _ _

/-- Divergence is independent of arbitrary finite-rank decompositions of the same actual field. -/
theorem cylindricalDivergence_representation_independent
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace)
    (a : κ → polynomialCylindricalDomain) (b : κ → CoefficientSpace)
    (he : cylindricalField g h = cylindricalField a b) :
    cylindricalDivergenceExpression g h = cylindricalDivergenceExpression a b :=
  cylindricalDivergence.mem_graph_snd_inj (cylindricalDivergence_field_graph g h)
    (cylindricalDivergence_field_graph a b) he

theorem cylindricalField_mem_domain {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace) :
    cylindricalField g h ∈ cylindricalDivergence.domain :=
  LinearPMap.mem_domain_iff.mpr ⟨_, cylindricalDivergence_field_graph g h⟩

theorem cylindricalDivergence_field_apply {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace)
    (hu : cylindricalField g h ∈ cylindricalDivergence.domain) :
    cylindricalDivergence ⟨cylindricalField g h, hu⟩ = cylindricalDivergenceExpression g h :=
  cylindricalDivergence.mem_graph_snd_inj (cylindricalDivergence.mem_graph _)
    (cylindricalDivergence_field_graph g h) rfl

/-- The genuine Gaussian expectation identity on every finite-rank cylindrical field. -/
theorem cylindricalField_integration_by_parts {ι : Type*} [Fintype ι]
    (f : polynomialCylindricalDomain) (g : ι → polynomialCylindricalDomain)
    (h : ι → CoefficientSpace) :
    (∫ ω, inner ℝ (polynomialDerivative f ω) (cylindricalField g h ω) ∂gaussianProduct) =
      ∫ ω, (f : GaussianL2) ω * cylindricalDivergenceExpression g h ω ∂gaussianProduct := by
  have hp := cylindricalDerivative_formalAdjoint f
    ⟨cylindricalField g h, cylindricalField_mem_domain g h⟩
  rw [cylindricalDivergence_field_apply, L2_inner_eq_integral, L2_inner_eq_integral] at hp
  simpa [cylindricalDerivative, LinearPMap.toFun', Real.inner_apply, mul_comm] using hp

/-- Both integrands in the genuine cylindrical IBP identity are integrable. -/
theorem cylindricalField_ibp_integrable {ι : Type*} [Fintype ι]
    (f : polynomialCylindricalDomain) (g : ι → polynomialCylindricalDomain)
    (h : ι → CoefficientSpace) :
    Integrable (fun ω => inner ℝ (polynomialDerivative f ω) (cylindricalField g h ω))
      gaussianProduct ∧
    Integrable (fun ω => (f : GaussianL2) ω * cylindricalDivergenceExpression g h ω)
      gaussianProduct :=
  ⟨(inner_memLp (p := 2) (q := 2) (r := 1) (Lp.memLp (polynomialDerivative f))
    (Lp.memLp (cylindricalField g h))).integrable (by simp),
    mul_L2_integrable (Lp.memLp (f : GaussianL2)) (Lp.memLp (cylindricalDivergenceExpression g h))⟩

/-- The closed derivative contains the actual polynomial values of D₀. -/
theorem closedCylindricalDerivative_core_graph (f : polynomialCylindricalDomain) :
    ((f : GaussianL2), polynomialDerivative f) ∈ closedCylindricalDerivative.graph :=
  LinearPMap.le_graph_of_le cylindricalDerivative.le_closure (cylindricalDerivative.mem_graph f)

theorem closedCylindricalDerivative_core_mem (f : polynomialCylindricalDomain) :
    (f : GaussianL2) ∈ closedCylindricalDerivative.domain :=
  LinearPMap.mem_domain_iff.mpr ⟨_, closedCylindricalDerivative_core_graph f⟩

theorem closedCylindricalDerivative_core_apply (f : polynomialCylindricalDomain)
    (hf : (f : GaussianL2) ∈ closedCylindricalDerivative.domain) :
    closedCylindricalDerivative ⟨f, hf⟩ = polynomialDerivative f :=
  closedCylindricalDerivative.mem_graph_snd_inj (closedCylindricalDerivative.mem_graph _)
    (closedCylindricalDerivative_core_graph f) rfl

/-- The full adjoint contains the explicit finite-rank divergence formula with its actual value. -/
theorem hilbertDivergence_field_graph {ι : Type*} [Fintype ι]
    (g : ι → polynomialCylindricalDomain) (h : ι → CoefficientSpace) :
    (cylindricalField g h, cylindricalDivergenceExpression g h) ∈ hilbertDivergence.graph :=
  LinearPMap.le_graph_of_le cylindricalDivergence_le_hilbertDivergence
    (cylindricalDivergence_field_graph g h)

/-- The vector core is exactly the actual finite-sum Gⱼ hⱼ class, not a larger assumed domain. -/
theorem cylindricalVectorDomain_mem_iff (u : GaussianVectorL2) :
    u ∈ cylindricalVectorDomain ↔ ∃ (n : ℕ) (g : Fin n → polynomialCylindricalDomain)
      (h : Fin n → CoefficientSpace), cylindricalField g h = u := by
  classical
  constructor
  · intro hu
    obtain ⟨n, c, a, ha⟩ := Submodule.mem_span_set'.mp hu
    have hx (i : Fin n) : ∃ (g : polynomialCylindricalDomain) (h : CoefficientSpace),
        scalarTensor h g = (a i : GaussianVectorL2) := (a i).property
    choose g h hg using hx
    refine ⟨n, (fun i => c i • g i), h, ?_⟩
    unfold cylindricalField
    simp only [Submodule.coe_smul, map_smul, hg]
    exact ha
  · rintro ⟨n, g, h, rfl⟩
    rw [← cylindricalDivergence_domain]
    exact cylindricalField_mem_domain g h

/-- The graph closure of D₀ remains inside δ₀*, without any graph-density equality assumption. -/
theorem closedCylindricalDerivative_le_cylindricalDivergence_adjoint :
    closedCylindricalDerivative ≤ cylindricalDivergence.adjoint :=
  operatorClosure_le_closed cylindricalDerivative_isClosable
    (cylindricalDivergence.adjoint_isClosed cylindricalDivergence_dense_domain)
    cylindricalDerivative_le_divergence_adjoint

/-- Every ℓ²-valued L² field admits norm approximation
by one genuine finite-rank polynomial field. -/
theorem exists_cylindricalField_approx (u : GaussianVectorL2) (ε : ℝ) (hε : 0 < ε) :
    ∃ (n : ℕ) (g : Fin n → polynomialCylindricalDomain) (h : Fin n → CoefficientSpace),
      ‖u - cylindricalField g h‖ < ε := by
  obtain ⟨v, hv, he⟩ := Metric.mem_closure_iff.mp (cylindricalVectorDomain_dense u) ε hε
  obtain ⟨n, g, h, rfl⟩ := (cylindricalVectorDomain_mem_iff v).mp hv
  exact ⟨n, g, h, by simpa [dist_eq_norm] using he⟩
end OperatorDerivativeRewrite.Foundation.InfiniteGaussian
