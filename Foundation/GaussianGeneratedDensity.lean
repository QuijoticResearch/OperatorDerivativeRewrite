import Foundation.FiniteGaussianObservationDensity
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Unique

/-! Density for the sigma-algebra generated by an arbitrary family of actual
Gaussian coordinates. The index set need not be countable or independent. -/
noncomputable section
open MeasureTheory ProbabilityTheory MvPolynomial
open scoped ENNReal Topology
namespace OperatorDerivativeRewrite.Foundation.InfiniteGaussian
set_option backward.isDefEq.respectTransparency false
variable {I : Type*}

def familyPolynomialEmbedding (h : I → CoefficientSpace) : MvPolynomial I ℝ →ₗ[ℝ] GaussianL2 where
  toFun := isonormalCylinderL2 h
  map_add' p q := by
    apply Lp.ext
    filter_upwards [isonormalCylinderL2_coeFn h (p+q), isonormalCylinderL2_coeFn h p,
      isonormalCylinderL2_coeFn h q, Lp.coeFn_add (isonormalCylinderL2 h p)
        (isonormalCylinderL2 h q)] with ω ha hp hq hs
    change isonormalCylinderL2 h (p + q) ω =
      (isonormalCylinderL2 h p + isonormalCylinderL2 h q) ω
    rw [ha, hs]
    simp [hp, hq, isonormalCylinder]
  map_smul' c p := by
    apply Lp.ext
    filter_upwards [isonormalCylinderL2_coeFn h (c • p), isonormalCylinderL2_coeFn h p,
      Lp.coeFn_smul c (isonormalCylinderL2 h p)] with ω ha hp hs
    simp [ha, hs, hp, isonormalCylinder]

theorem familyPolynomial_rename (h : I → CoefficientSpace) (s : Finset I)
    (p : MvPolynomial s ℝ) :
    familyPolynomialEmbedding h (rename Subtype.val p) =
      isonormalCylinderL2 (fun i : s => h i) p := by
  apply Lp.ext
  filter_upwards [isonormalCylinderL2_coeFn h (rename Subtype.val p),
    isonormalCylinderL2_coeFn (fun i : s => h i) p] with ω hl hr
  change isonormalCylinderL2 h (rename Subtype.val p) ω = _
  rw [hl, hr]
  simp [isonormalCylinder, eval_rename, Function.comp_def]

theorem familyPolynomial_aestronglyMeasurable (h : I → CoefficientSpace)
    (p : MvPolynomial I ℝ) :
    AEStronglyMeasurable[MeasurableSpace.comap (firstChaosFamily h) inferInstance]
      (familyPolynomialEmbedding h p) gaussianProduct := by
  obtain ⟨s, q, rfl⟩ := exists_finset_rename p
  rw [familyPolynomial_rename]
  exact aestronglyMeasurable_comap_of_ae_factor
    (Measurable.of_eval (fun i : s => measurable_pi_apply i.val))
    (Filter.Eventually.of_forall (fun _ => rfl))
    (isonormalPolynomial_aestronglyMeasurable (fun i : s => h i) q)

theorem familyPolynomial_closure_le_measurable (h : I → CoefficientSpace) :
    (familyPolynomialEmbedding h).range.topologicalClosure ≤
      lpMeas ℝ ℝ (MeasurableSpace.comap (firstChaosFamily h) inferInstance) 2 gaussianProduct := by
  apply Submodule.topologicalClosure_minimal
  · rintro F ⟨p, rfl⟩
    exact familyPolynomial_aestronglyMeasurable h p
  · exact isClosed_aestronglyMeasurable
      (Measurable.of_eval (fun i =>
        (Lp.stronglyMeasurable (firstChaosEmbedding (h i))).measurable)).comap_le

/-- Orthogonality to all family polynomials forces vanishing against every
finite-observation L2 class, by the proved finite (possibly singular) density. -/
theorem familyPolynomial_orthogonal_finite (h : I → CoefficientSpace) (F : GaussianL2)
    (hF : F ∈ (familyPolynomialEmbedding h).rangeᗮ) (s : Finset I)
    (G : GaussianL2)
    (hG : AEStronglyMeasurable[MeasurableSpace.comap
      (firstChaosFamily (fun i : s => h i)) inferInstance] G gaussianProduct) :
    inner ℝ F G = 0 := by
  have hc : IsClosed {G : GaussianL2 | inner ℝ F G = 0} :=
    isClosed_eq (continuous_const.inner continuous_id) continuous_const
  have hs : closure (Set.range (isonormalCylinderL2 (fun i : s => h i))) ⊆
      {G : GaussianL2 | inner ℝ F G = 0} := by
    apply closure_minimal _ hc
    rintro G ⟨p, rfl⟩
    apply (familyPolynomialEmbedding h).range.inner_left_of_mem_orthogonal _ hF
    exact ⟨rename Subtype.val p, familyPolynomial_rename h s p⟩
  rw [isonormalPolynomial_closure] at hs
  exact hs hG

theorem familyPolynomial_orthogonal_cylinder (h : I → CoefficientSpace) (F : GaussianL2)
    (hF : F ∈ (familyPolynomialEmbedding h).rangeᗮ) (s : Finset I)
    (S : Set (s → ℝ)) (hS : MeasurableSet S) :
    (∫ ω in firstChaosFamily h ⁻¹' cylinder s S, F ω ∂gaussianProduct) = 0 := by
  let X := firstChaosFamily (fun i : s => h i)
  have hX : Measurable X := Measurable.of_eval (fun i => (Lp.stronglyMeasurable _).measurable)
  have hm : MeasurableSet (X ⁻¹' S) := hS.preimage hX
  let G : GaussianL2 := indicatorConstLp 2 hm (measure_ne_top _ _) (1 : ℝ)
  have hG : AEStronglyMeasurable[MeasurableSpace.comap X inferInstance] G gaussianProduct := by
    have hi : StronglyMeasurable[MeasurableSpace.comap X inferInstance]
        ((X ⁻¹' S).indicator (fun _ => (1 : ℝ))) :=
      stronglyMeasurable_const.indicator ⟨S, hS, rfl⟩
    exact hi.aestronglyMeasurable.congr indicatorConstLp_coeFn.symm
  have hz := familyPolynomial_orthogonal_finite h F hF s G hG
  rw [real_inner_comm] at hz
  change inner ℝ (indicatorConstLp 2 hm (measure_ne_top _ _) (1 : ℝ)) F = 0 at hz
  rw [L2.inner_indicatorConstLp_one] at hz
  exact hz

/-- A pi-lambda argument is performed on the observation sigma-algebra, not
on the larger ambient Gaussian sigma-algebra. -/
theorem familyPolynomial_orthogonal_measurable_zero (h : I → CoefficientSpace)
    (F : GaussianL2) (hF : F ∈ (familyPolynomialEmbedding h).rangeᗮ)
    (hmF : AEStronglyMeasurable[MeasurableSpace.comap (firstChaosFamily h)
      inferInstance] F gaussianProduct) : F = 0 := by
  have hi : Integrable F gaussianProduct := (Lp.memLp F).integrable (by simp)
  have hX : Measurable (firstChaosFamily h) :=
    Measurable.of_eval (fun i => (Lp.stronglyMeasurable _).measurable)
  have hu : (∫ ω, F ω ∂gaussianProduct) = 0 := by
    simpa [cylinder] using familyPolynomial_orthogonal_cylinder h F hF ∅ Set.univ MeasurableSet.univ
  have hall : ∀ A : Set (I → ℝ), MeasurableSet A →
      (∫ ω in firstChaosFamily h ⁻¹' A, F ω ∂gaussianProduct) = 0 := by
    refine MeasurableSpace.induction_on_inter
      (C := fun A _ => (∫ ω in firstChaosFamily h ⁻¹' A, F ω ∂gaussianProduct) = 0)
      (generateFrom_measurableCylinders (α := fun _ : I => ℝ)).symm
      isPiSystem_measurableCylinders (by simp) ?_ ?_ ?_
    · intro A hA
      obtain ⟨s, S, hS, rfl⟩ := (mem_measurableCylinders A).mp hA
      exact familyPolynomial_orthogonal_cylinder h F hF s S hS
    · intro A hA hz
      rw [Set.preimage_compl, setIntegral_compl (hA.preimage hX) hi, hu, hz, sub_self]
    · intro A hd hm hz
      rw [Set.preimage_iUnion, integral_iUnion (fun n => (hm n).preimage hX)
        (hd.mono fun i j hij => hij.preimage _) hi.integrableOn]
      simp only [hz, tsum_zero]
  have hz : F =ᵐ[gaussianProduct] (0 : SampleSpace → ℝ) :=
    Lp.ae_eq_zero_of_forall_setIntegral_eq_zero' ℝ hX.comap_le F (by norm_num) (by simp)
      (fun _ _ _ => hi.integrableOn)
      (by rintro A ⟨S, hS, rfl⟩ _; exact hall S hS) hmF
  exact Lp.ext (hz.trans (Lp.coeFn_zero (E := ℝ) (p := 2) (μ := gaussianProduct)).symm)

/-- Genuine density in the entire sigma-algebra generated by an arbitrary
Gaussian family, without a countability assumption on its index set. -/
theorem familyPolynomial_closure (h : I → CoefficientSpace) :
    (familyPolynomialEmbedding h).range.topologicalClosure =
      lpMeas ℝ ℝ (MeasurableSpace.comap (firstChaosFamily h) inferInstance) 2 gaussianProduct := by
  have hz : (familyPolynomialEmbedding h).range.topologicalClosureᗮ ⊓
      lpMeas ℝ ℝ (MeasurableSpace.comap (firstChaosFamily h) inferInstance)
        2 gaussianProduct = ⊥ := by
    apply eq_bot_iff.mpr
    rintro F ⟨hFo, hmF⟩
    apply familyPolynomial_orthogonal_measurable_zero h F _ hmF
    exact Submodule.orthogonal_le (familyPolynomialEmbedding h).range.le_topologicalClosure hFo
  have he := Submodule.sup_orthogonal_inf_of_hasOrthogonalProjection
    (familyPolynomial_closure_le_measurable h)
  simpa only [hz, sup_bot_eq] using he

end OperatorDerivativeRewrite.Foundation.InfiniteGaussian
