theorem point_embedding : ∀ k, embedEdge (.inr (point k))=edgeData k := by decide +kernel

theorem edgeData_injective : Function.Injective edgeData := by decide +kernel

theorem point_bijective : Function.Bijective point := by
  apply (Fintype.bijective_iff_injective_and_card point).mpr
  constructor
  · intro i j hij
    apply edgeData_injective
    rw [← point_embedding,← point_embedding,hij]
  · simpa only [Fintype.card_fin] using boundary_card.symm

theorem vertexPoint_embedding_injective :
    Function.Injective (fun k => embedVertex (vertexPoint k)) := by decide +kernel

theorem vertexPoint_bijective : Function.Bijective vertexPoint := by
  apply (Fintype.bijective_iff_injective_and_card vertexPoint).mpr
  constructor
  · intro i j hij
    exact vertexPoint_embedding_injective (congrArg embedVertex hij)
  · simpa only [Fintype.card_fin] using fullVertex_card.symm

theorem point_source : ∀ k, source (.inr (point k))=vertexPoint (sourceIndex k) := by
  decide +kernel

theorem point_target : ∀ k, target (.inr (point k))=vertexPoint (targetIndex k) := by
  intro k
  apply embedVertex_injective
  revert k
  decide +kernel
theorem chord_identity : ∀ i j : Fin 34, cycleData (chord i) j=if i=j then 1 else 0 := by
  decide +kernel

def gradientData (k : Fin 80) (v : Fin 48) : ℤ :=
  (if v=targetIndex k then 1 else 0)-(if v=sourceIndex k then 1 else 0)

theorem cycle_balance : ∀ j : Fin 34, ∀ v : Fin 48,
    (∑ k : Fin 80, cycleData k j*gradientData k v)=0 := by
  decide +kernel

end OperatorDerivativeRewrite.Foundation.OneSidedBoundaryCycleData
