import Foundation.L2GeneratedSubspace
import Foundation.InfiniteGaussianRepresentation
import Foundation.FiniteGaussianCompleteness
import Mathlib.Algebra.MvPolynomial.Monad

/-! Polynomial approximation in generated Gaussian observation subspaces.
The observation law, rather than the whole ambient probability space,
determines the L2 domain being approximated. -/
noncomputable section
open MeasureTheory ProbabilityTheory MvPolynomial
open scoped ENNReal Topology
namespace OperatorDerivativeRewrite.Foundation.InfiniteGaussian
set_option backward.isDefEq.respectTransparency false

section FiniteSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

/-- Polynomial approximation for the sigma-algebra of an actual finite Hilbert
Gaussian realization, including the zero-dimensional space. -/
theorem finiteGaussianPoint_polynomial_approx (A : E →ₗᵢ[ℝ] CoefficientSpace)
    (F : GaussianL2)
    (hF : AEStronglyMeasurable[MeasurableSpace.comap (finiteGaussianPoint A)
      inferInstance] F gaussianProduct) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : MvPolynomial (Fin (Module.finrank ℝ E)) ℝ,
      ‖F - isonormalCylinderL2 (fun i => A (stdOrthonormalBasis ℝ E i)) p‖ < ε := by
  classical
  let b := stdOrthonormalBasis ℝ E
  let Z := finiteGaussianPoint A
  let Y := FiniteGaussian.coordinateFamily b ∘ Z
  have hZ : MeasurePreserving Z gaussianProduct (stdGaussian E) :=
    ⟨finiteGaussianPoint_measurable A, finiteGaussianPoint_law A⟩
  have hY : MeasurePreserving Y gaussianProduct
      (FiniteGaussian.productGaussian (Fin (Module.finrank ℝ E))) :=
    (FiniteGaussian.orthonormal_coordinates_measurePreserving b).comp hZ
  have hZY : Z =ᵐ[gaussianProduct] (fun x => ∑ i, x i • b i) ∘ Y := by
    apply Filter.Eventually.of_forall
    intro ω
    exact (b.sum_repr' (Z ω)).symm
  have hFY : AEStronglyMeasurable[MeasurableSpace.comap Y inferInstance] F gaussianProduct :=
    aestronglyMeasurable_comap_of_ae_factor (by fun_prop) hZY hF
  obtain ⟨g, ⟨p, rfl⟩, hp⟩ := exists_L2_pullback_approx hY
    FiniteGaussian.productPolynomialEmbedding_dense F hFY ε hε
  refine ⟨p, ?_⟩
  have he : Lp.compMeasurePreserving Y hY (FiniteGaussian.productPolynomialL2 p) =
      isonormalCylinderL2 (fun i => A (b i)) p := by
    apply Lp.ext
    have hpoly := hY.quasiMeasurePreserving.ae_eq_comp
      (FiniteGaussian.productPolynomialL2_coeFn p)
    filter_upwards [Lp.coeFn_compMeasurePreserving (FiniteGaussian.productPolynomialL2 p) hY,
      hpoly, isonormalCylinderL2_coeFn (fun i => A (b i)) p,
      ae_all_iff.2 (fun i => finiteGaussianPoint_coordinate A (b i))] with ω hc hp hi hw
    rw [hc, hp, hi]
    change eval (Y ω) p = eval (fun i => firstChaosEmbedding (A (b i)) ω) p
    apply congrArg (fun x => eval x p)
    funext i
    exact (hw i).symm
  change ‖F - Lp.compMeasurePreserving Y hY (FiniteGaussian.productPolynomialL2 p)‖ < ε at hp
  rwa [he] at hp

end FiniteSpace

/-- Polynomial substitution along actual linear combinations of first-chaos
directions, including dependent or zero directions. -/
theorem isonormalCylinderL2_linear_substitution {ι κ : Type*}
    [Fintype ι] [Finite κ] (h : ι → CoefficientSpace) (c : κ → ι → ℝ)
    (p : MvPolynomial κ ℝ) :
    isonormalCylinderL2 (fun j => ∑ i, c j i • h i) p =
      isonormalCylinderL2 h (bind₁ (fun j => ∑ i, C (c j i) * X i) p) := by
  classical
  let := Fintype.ofFinite κ
  apply Lp.ext
  filter_upwards [isonormalCylinderL2_coeFn (fun j => ∑ i, c j i • h i) p,
    isonormalCylinderL2_coeFn h (bind₁ (fun j => ∑ i, C (c j i) * X i) p),
    ae_all_iff.2 (fun j => firstChaos_linearCombination_ae h (c j))] with ω hl hr hw
  rw [hl, hr]
  change eval (fun j => firstChaosEmbedding (∑ i, c j i • h i) ω) p = _
  have he : (fun j => firstChaosEmbedding (∑ i, c j i • h i) ω) =
      fun j => ∑ i, c j i * firstChaosEmbedding (h i) ω := funext hw
  rw [he]
  change _ = eval₂Hom (RingHom.id ℝ) (fun i => firstChaosEmbedding (h i) ω)
    (bind₁ (fun j => ∑ i, C (c j i) * X i) p)
  rw [eval₂Hom_bind₁]
  simp

/-- Genuine polynomial density in the L2 subspace generated by ANY finite
Gaussian observation family. No covariance inverse or independence hypothesis
is used; repetitions, zero vectors and an empty family are allowed. -/
theorem exists_isonormalPolynomial_approx {ι : Type*} [Finite ι]
    (h : ι → CoefficientSpace) (F : GaussianL2)
    (hF : AEStronglyMeasurable[MeasurableSpace.comap (firstChaosFamily h)
      inferInstance] F gaussianProduct) (ε : ℝ) (hε : 0 < ε) :
    ∃ p : MvPolynomial ι ℝ, ‖F - isonormalCylinderL2 h p‖ < ε := by
  classical
  let := Fintype.ofFinite ι
  let S := Submodule.span ℝ (Set.range h)
  let : FiniteDimensional ℝ S := FiniteDimensional.span_of_finite ℝ (Set.finite_range h)
  let : MeasurableSpace S := borel S
  let : BorelSpace S := ⟨rfl⟩
  let h' : ι → S := fun i => ⟨h i, Submodule.subset_span (Set.mem_range_self i)⟩
  let Z := finiteGaussianPoint S.subtypeₗᵢ
  have hXZ : firstChaosFamily h =ᵐ[gaussianProduct] FiniteGaussian.coordinateFamily h' ∘ Z := by
    filter_upwards [ae_all_iff.2 (fun i => finiteGaussianPoint_coordinate S.subtypeₗᵢ (h' i))]
      with ω hw
    exact funext hw
  have hFZ : AEStronglyMeasurable[MeasurableSpace.comap Z inferInstance] F gaussianProduct :=
    aestronglyMeasurable_comap_of_ae_factor (by fun_prop) hXZ hF
  obtain ⟨p, hp⟩ := finiteGaussianPoint_polynomial_approx S.subtypeₗᵢ F hFZ ε hε
  let b := stdOrthonormalBasis ℝ S
  have hb (j : Fin (Module.finrank ℝ S)) :
      ∃ c : ι → ℝ, ∑ i, c i • h i = (b j : CoefficientSpace) :=
    (Submodule.mem_span_range_iff_exists_fun ℝ).mp (b j).property
  choose c hc using hb
  refine ⟨bind₁ (fun j => ∑ i, C (c j i) * X i) p, ?_⟩
  have he : (fun j => ∑ i, c j i • h i) = fun j => (b j : CoefficientSpace) := funext hc
  have hs := isonormalCylinderL2_linear_substitution h c p
  rw [he] at hs
  rw [← hs]
  exact hp

theorem isonormalPolynomial_aestronglyMeasurable {ι : Type*} [Finite ι]
    (h : ι → CoefficientSpace) (p : MvPolynomial ι ℝ) :
    AEStronglyMeasurable[MeasurableSpace.comap (firstChaosFamily h) inferInstance]
      (isonormalCylinderL2 h p) gaussianProduct := by
  have hp : StronglyMeasurable (fun x : ι → ℝ => eval x p) :=
    p.continuous_eval.measurable.stronglyMeasurable
  have hm := hp.comp_measurable
    (Measurable.of_comap_le le_rfl : Measurable[
      MeasurableSpace.comap (firstChaosFamily h) inferInstance] (firstChaosFamily h))
  exact hm.aestronglyMeasurable.congr (isonormalCylinderL2_coeFn h p).symm

/-- The closure equals the independently defined generated measurable subspace,
not merely the closure of a polynomial span by definition. -/
theorem isonormalPolynomial_closure {ι : Type*} [Finite ι]
    (h : ι → CoefficientSpace) :
    closure (Set.range (isonormalCylinderL2 h)) =
      (lpMeas ℝ ℝ (MeasurableSpace.comap (firstChaosFamily h) inferInstance)
        2 gaussianProduct : Set GaussianL2) := by
  apply Set.Subset.antisymm
  · apply closure_minimal
    · rintro F ⟨p, rfl⟩
      exact isonormalPolynomial_aestronglyMeasurable h p
    · exact isClosed_aestronglyMeasurable (by
        apply Measurable.comap_le
        exact Measurable.of_eval (fun i => (Lp.stronglyMeasurable _).measurable))
  · intro F hF
    apply Metric.mem_closure_iff.mpr
    intro ε hε
    obtain ⟨p, hp⟩ := exists_isonormalPolynomial_approx h F hF ε hε
    exact ⟨_, ⟨p, rfl⟩, by simpa only [dist_eq_norm] using hp⟩

end OperatorDerivativeRewrite.Foundation.InfiniteGaussian
