theorem interiorPoint_val_injective : Function.Injective (fun k => (interiorPoint k).val) := by
  decide +kernel

theorem interiorPoint_bijective : Function.Bijective interiorPoint := by
  apply (Fintype.bijective_iff_injective_and_card interiorPoint).mpr
  constructor
  · intro i j hij
    exact interiorPoint_val_injective (congrArg Subtype.val hij)
  · simpa only [Fintype.card_fin] using interior_card.symm

theorem face_embedding : ∀ r, (embedFace (facePoint r)).val=sourceFaceData r := by
  decide +kernel

theorem sourceFaceData_injective : Function.Injective sourceFaceData := by decide +kernel

theorem facePoint_bijective : Function.Bijective facePoint := by
  apply (Fintype.bijective_iff_injective_and_card facePoint).mpr
  constructor
  · intro i j hij
    apply sourceFaceData_injective
    rw [← face_embedding,← face_embedding,hij]
  · simpa only [Fintype.card_fin] using fullFace_card.symm

def integerEntry (p : FullFace) (e : FullEdge) : ℤ :=
  (if embedEdge (rowEdges p 0)=embedEdge e then 1 else 0)+
    (if embedEdge (rowEdges p 1)=embedEdge e then 1 else 0)-
    (if embedEdge (rowEdges p 2)=embedEdge e then 1 else 0)-
    (if embedEdge (rowEdges p 3)=embedEdge e then 1 else 0)

theorem Adata_geometry : ∀ r i,
    integerEntry (facePoint r) (.inl (interiorPoint i))=signData r*Adata r i := by
  decide +kernel

theorem Bdata_geometry : ∀ r k,
    integerEntry (facePoint r) (.inr (point k))=signData r*Bdata r k := by
  decide +kernel

theorem sign_square : ∀ r, signData r*signData r=1 := by decide +kernel

open scoped Classical

theorem single_curl (p : FullFace) (e : FullEdge) :
    faceCurl (Pi.single e (1 : ℝ)) p=(integerEntry p e : ℝ) := by
  classical
  rw [row_formula]
  simp [integerEntry,Pi.single_apply,embedEdge_injective.eq_iff,eq_comm]

theorem interior_single (e : Interior) :
    injectInterior (Pi.single e (1 : ℝ))=Pi.single (.inl e) 1 := by
  classical
  funext q
  cases q <;> simp [injectInterior,Pi.single_apply]

theorem boundary_single (b : Boundary) :
    injectBoundary (Pi.single b (1 : ℝ))=Pi.single (.inr b) 1 := by
  classical
  funext q
  cases q <;> simp [injectBoundary,Pi.single_apply]

theorem fullMatrix_entry (p : FullFace) (e : Interior) :
    fullMatrix p e=(integerEntry p (.inl e) : ℝ) := by
  classical
  rw [fullMatrix,LinearMap.toMatrix'_apply]
  change flatten (incidence (Pi.single e (1 : ℝ))) p=_
  rw [← d1_interior]
  change faceCurl (injectInterior (Pi.single e (1 : ℝ))) p=_
  rw [interior_single,single_curl]

theorem boundaryMatrix_entry (p : FullFace) (b : Boundary) :
    boundaryMatrix p b=(integerEntry p (.inr b) : ℝ) := by
  classical
  rw [boundaryMatrix,LinearMap.toMatrix'_apply]
  change faceCurl (injectBoundary (Pi.single b (1 : ℝ))) p=_
  rw [boundary_single,single_curl]

theorem fullMatrix_at_points (r : Fin 72) (i : Fin 32) :
    fullMatrix (facePoint r) (interiorPoint i)=(signData r : ℝ)*(Adata r i : ℝ) := by
  rw [fullMatrix_entry,Adata_geometry,Int.cast_mul]

theorem boundaryMatrix_at_points (r : Fin 72) (k : Fin 80) :
    boundaryMatrix (facePoint r) (point k)=(signData r : ℝ)*(Bdata r k : ℝ) := by
  rw [boundaryMatrix_entry,Bdata_geometry,Int.cast_mul]

end OperatorDerivativeRewrite.Foundation.OneSidedSourceMatrixData
