def lo (j k : ℕ) : ℤ := ((data.getD j []).getD k (0,0)).1
def hi (j k : ℕ) : ℤ := ((data.getD j []).getD k (0,0)).2
theorem sums_0 : (∑ j ∈ Finset.range 160, lo j 0)=-1641482419995 ∧ (∑ j ∈ Finset.range 160, hi j 0)=-1641482419749 := by
  decide +kernel
theorem sums_1 : (∑ j ∈ Finset.range 160, lo j 1)=3656317813 ∧ (∑ j ∈ Finset.range 160, hi j 1)=3656318043 := by
  decide +kernel
theorem sums_2 : (∑ j ∈ Finset.range 160, lo j 2)=-1460002952576 ∧ (∑ j ∈ Finset.range 160, hi j 2)=-1460002952347 := by
  decide +kernel

theorem rational_sum (f : ℕ → ℤ) :
    (∑ j ∈ Finset.range 160, (f j : ℚ)/(10^22 : ℚ))=
      ((∑ j ∈ Finset.range 160, f j : ℤ) : ℚ)/(10^22 : ℚ) := by
  rw [← Finset.sum_div]
  norm_cast

theorem target_sums :
    (∑ j ∈ Finset.range 160, (hi j 0 : ℚ)/10^22) ≤ -(164/10^12 : ℚ) ∧
    -(38/10^14 : ℚ) ≤ (∑ j ∈ Finset.range 160, (lo j 1 : ℚ)/10^22) ∧
    (∑ j ∈ Finset.range 160, (hi j 1 : ℚ)/10^22) ≤ (38/10^14 : ℚ) ∧
    (∑ j ∈ Finset.range 160, (hi j 2 : ℚ)/10^22) ≤ -(1455/10^13 : ℚ) := by
  simp only [rational_sum, sums_0.2, sums_1.1, sums_1.2, sums_2.2]
  norm_num

def check (j k : ℕ) : Bool :=
  inside (evenPolynomialBox j k) ((lo j k : ℚ)/10^22) ((hi j k : ℚ)/10^22)

theorem cell_bounds (j k : ℕ) (hj : j < 160) (hk : k ≤ 2) (hc : check j k=true) :
    (((lo j k : ℚ)/10^22 : ℚ) : ℝ) ≤ polynomialIntegral j k ∧
      polynomialIntegral j k ≤ (((hi j k : ℚ)/10^22 : ℚ) : ℝ) :=
  inside_spec hc (evenPolynomialBox_mem j k hj hk)

theorem polynomial_bounds (hc : ∀ j < 160, ∀ k ≤ 2, check j k=true) :
    totalPolynomial 0 ≤ -(164/10^12 : ℝ) ∧
      |totalPolynomial 1| ≤ (38/10^14 : ℝ) ∧
        totalPolynomial 2 ≤ -(1455/10^13 : ℝ) := by
  have hb (j k : ℕ) (hj : j < 160) (hk : k ≤ 2) :=
    cell_bounds j k hj hk (hc j hj k hk)
  have hu (k : ℕ) (hk : k ≤ 2) :
      totalPolynomial k ≤
        ∑ j ∈ Finset.range 160, (((hi j k : ℚ)/10^22 : ℚ) : ℝ) := by
    apply Finset.sum_le_sum
    intro j hj
    exact (hb j k (Finset.mem_range.mp hj) hk).2
  have hl (k : ℕ) (hk : k ≤ 2) :
      (∑ j ∈ Finset.range 160, (((lo j k : ℚ)/10^22 : ℚ) : ℝ)) ≤
        totalPolynomial k := by
    apply Finset.sum_le_sum
    intro j hj
    exact (hb j k (Finset.mem_range.mp hj) hk).1
  have h0 : (∑ j ∈ Finset.range 160, (((hi j 0 : ℚ)/10^22 : ℚ) : ℝ)) ≤
      -(164/10^12 : ℝ) := by
    have h : ((∑ j ∈ Finset.range 160, (hi j 0 : ℚ)/10^22 : ℚ) : ℝ) ≤
        ((-(164/10^12 : ℚ) : ℚ) : ℝ) := Rat.cast_le.mpr target_sums.1
    simpa only [Rat.cast_sum, Rat.cast_neg, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using h
  have h1l : -(38/10^14 : ℝ) ≤
      ∑ j ∈ Finset.range 160, (((lo j 1 : ℚ)/10^22 : ℚ) : ℝ) := by
    have h : ((-(38/10^14 : ℚ) : ℚ) : ℝ) ≤
        ((∑ j ∈ Finset.range 160, (lo j 1 : ℚ)/10^22 : ℚ) : ℝ) :=
      Rat.cast_le.mpr target_sums.2.1
    simpa only [Rat.cast_sum, Rat.cast_neg, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using h
  have h1u : (∑ j ∈ Finset.range 160, (((hi j 1 : ℚ)/10^22 : ℚ) : ℝ)) ≤
      (38/10^14 : ℝ) := by
    have h : ((∑ j ∈ Finset.range 160, (hi j 1 : ℚ)/10^22 : ℚ) : ℝ) ≤
        ((38/10^14 : ℚ) : ℝ) := Rat.cast_le.mpr target_sums.2.2.1
    simpa only [Rat.cast_sum, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using h
  have h2 : (∑ j ∈ Finset.range 160, (((hi j 2 : ℚ)/10^22 : ℚ) : ℝ)) ≤
      -(1455/10^13 : ℝ) := by
    have h : ((∑ j ∈ Finset.range 160, (hi j 2 : ℚ)/10^22 : ℚ) : ℝ) ≤
        ((-(1455/10^13 : ℚ) : ℚ) : ℝ) := Rat.cast_le.mpr target_sums.2.2.2
    simpa only [Rat.cast_sum, Rat.cast_neg, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using h
  exact ⟨(hu 0 (by norm_num)).trans h0,
    abs_le.mpr ⟨h1l.trans (hl 1 (by norm_num)), (hu 1 (by norm_num)).trans h1u⟩,
    (hu 2 (by norm_num)).trans h2⟩

