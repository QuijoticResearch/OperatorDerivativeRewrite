import Foundation.GaussianTimeProductL2
import Foundation.GaussianPolynomialStepCompletion
import Foundation.InfiniteGaussianKernel

/-!
# Completion transport for actual polynomial predictable time-step fields

The domain is the closed span of the constructed polynomial past steps in
Lebesgue-time times Gaussian-probability L². An isometric equivalence to the
already constructed closed vector-field span is proved from actual tensor
pairings. No equality with the full predictable L² space is assumed or claimed.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal Topology

namespace OperatorDerivativeRewrite.Foundation.GaussianPredictableL2Completion

open InfiniteGaussian GaussianTimeHilbert GaussianTimeDivergence GaussianTimeFieldNorm
open GaussianTimeProductL2 GaussianTimePolynomialPairing GaussianPolynomialStepCompletion
open SeparableHilbertEmbedding
attribute [local instance] timeHilbert_secondCountable

/-- Actual product-space/vector-space pairs for the same finite polynomial past-step data. -/
def transportGenerators : Set (TimeProbabilityL2 × GaussianVectorL2) :=
  {z | ∃ (n : ℕ) (r : Fin n → ℝ≥0) (p : MvPolynomial (Fin n) ℝ) (s t : ℝ≥0),
    (∀ i, r i ≤ s) ∧ s ≤ t ∧
      z = (productTensor (intervalVector s t) (pastCoefficient r p),
        scalarTensor (incrementDirection s t) (pastCoefficient r p))}

/-- The algebraic relation generated by genuine pairs; well-definedness follows from pairing. -/
def transportRelation : Submodule ℝ (TimeProbabilityL2 × GaussianVectorL2) :=
  Submodule.span ℝ transportGenerators

/-- The algebraic polynomial time-step span in the actual product-measure space. -/
def productStepSpan : Submodule ℝ TimeProbabilityL2 :=
  transportRelation.map (LinearMap.fst ℝ TimeProbabilityL2 GaussianVectorL2)

/-- The explicit product-space domain to be completed; full predictable density is not assumed. -/
def closedProductSteps : Submodule ℝ TimeProbabilityL2 := productStepSpan.topologicalClosure

theorem closedProductSteps_complete : CompleteSpace closedProductSteps :=
  productStepSpan.isClosed_topologicalClosure.completeSpace_coe

theorem completedFields_complete : CompleteSpace completedFields :=
  elementaryFields.isClosed_topologicalClosure.completeSpace_coe

attribute [local instance] closedProductSteps_complete completedFields_complete

/-- The vector image is exactly the existing elementary field span. -/
theorem transportRelation_vector_image :
    transportRelation.map (LinearMap.snd ℝ TimeProbabilityL2 GaussianVectorL2) =
      elementaryFields := by
  rw [transportRelation, Submodule.map_span, elementaryFields, elementaryTimeGraph,
    Submodule.map_span]
  congr 1
  ext u
  constructor
  · rintro ⟨z, ⟨n, r, p, s, t, hrs, hst, rfl⟩, rfl⟩
    exact ⟨(scalarTensor (incrementDirection s t) (pastCoefficient r p),
      incrementProductL2 r p s t), ⟨n, r, p, s, t, hrs, hst, rfl⟩, rfl⟩
  · rintro ⟨z, ⟨n, r, p, s, t, hrs, hst, rfl⟩, rfl⟩
    exact ⟨(productTensor (intervalVector s t) (pastCoefficient r p),
      scalarTensor (incrementDirection s t) (pastCoefficient r p)),
      ⟨n, r, p, s, t, hrs, hst, rfl⟩, rfl⟩

/-- All actual tensor pairings are preserved, including sums over overlapping intervals. -/
theorem transportRelation_pairing (z w : TimeProbabilityL2 × GaussianVectorL2)
    (hz : z ∈ transportRelation) (hw : w ∈ transportRelation) :
    inner ℝ z.1 w.1 = inner ℝ z.2 w.2 := by
  refine Submodule.span_induction₂
    (p := fun z w _ _ => inner ℝ z.1 w.1 = inner ℝ z.2 w.2)
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ hz hw
  · rintro z w ⟨n, r, p, s, t, hrs, hst, rfl⟩
      ⟨m, q, v, a, b, hqa, hab, rfl⟩
    rw [productTensor_inner, scalarTensor_pair_inner]
    unfold incrementDirection
    rw [(hilbertEmbedding TimeHilbert).inner_map_map, mul_comm]
  · intro y hy
    simp
  · intro x hx
    simp
  · intro x y z hx hy hz hxz hyz
    simp only [Prod.fst_add, Prod.snd_add, inner_add_left, hxz, hyz]
  · intro x y z hx hy hz hxy hxz
    simp only [Prod.fst_add, Prod.snd_add, inner_add_right, hxy, hxz]
  · intro a x y hx hy hxy
    change inner ℝ (a • x.1) y.1 = inner ℝ (a • x.2) y.2
    simp only [real_inner_smul_left, hxy]
  · intro a x y hx hy hxy
    change inner ℝ x.1 (a • y.1) = inner ℝ x.2 (a • y.2)
    simp only [inner_smul_right, hxy]

theorem transportRelation_norm (z : TimeProbabilityL2 × GaussianVectorL2)
    (hz : z ∈ transportRelation) : ‖z.2‖ = ‖z.1‖ := by
  have h := transportRelation_pairing z z hz hz
  rw [real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq] at h
  nlinarith [norm_nonneg z.1, norm_nonneg z.2]

/-- Actual first-component assembly into its closed span. -/
def productAssembly : transportRelation →ₗ[ℝ] closedProductSteps where
  toFun z := ⟨z.val.1, productStepSpan.le_topologicalClosure
    (Submodule.mem_map.mpr ⟨z.val, z.property, rfl⟩)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Actual second-component assembly into the previously defined completed field domain. -/
def vectorAssembly : transportRelation →ₗ[ℝ] completedFields where
  toFun z := ⟨z.val.2, elementaryFields.le_topologicalClosure (by
    rw [← transportRelation_vector_image]
    exact Submodule.mem_map.mpr ⟨z.val, z.property, rfl⟩)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem productAssembly_dense : DenseRange productAssembly := by
  have hd : DenseRange (Submodule.inclusion productStepSpan.le_topologicalClosure) :=
    (denseRange_inclusion_iff productStepSpan.le_topologicalClosure).2 (by
      intro x hx
      exact hx)
  apply hd.mono
  rintro x ⟨u, rfl⟩
  obtain ⟨z, hz, he⟩ := Submodule.mem_map.mp u.property
  exact ⟨⟨z, hz⟩, Subtype.ext he⟩

theorem vectorAssembly_dense : DenseRange vectorAssembly := by
  have hd : DenseRange (Submodule.inclusion elementaryFields.le_topologicalClosure) :=
    (denseRange_inclusion_iff elementaryFields.le_topologicalClosure).2 (by
      intro x hx
      exact hx)
  apply hd.mono
  rintro x ⟨u, rfl⟩
  have hu : (u : GaussianVectorL2) ∈
      transportRelation.map (LinearMap.snd ℝ TimeProbabilityL2 GaussianVectorL2) := by
    rw [transportRelation_vector_image]
    exact u.property
  obtain ⟨z, hz, he⟩ := Submodule.mem_map.mp hu
  exact ⟨⟨z, hz⟩, Subtype.ext he⟩

theorem assembly_norm (z : transportRelation) : ‖vectorAssembly z‖ = ‖productAssembly z‖ :=
  transportRelation_norm z.val z.property

/-- The constructed onto isometric identification of the two explicit closed polynomial spans. -/
def productToField : closedProductSteps ≃ₗᵢ[ℝ] completedFields :=
  (LinearEquiv.refl ℝ transportRelation).extendOfIsometry productAssembly vectorAssembly
    productAssembly_dense vectorAssembly_dense assembly_norm

theorem productToField_assembly (z : transportRelation) :
    productToField (productAssembly z) = vectorAssembly z := by
  unfold productToField
  exact (LinearEquiv.refl ℝ transportRelation).extendOfIsometry_eq
    productAssembly vectorAssembly productAssembly_dense vectorAssembly_dense assembly_norm z

/-- A genuine generator in the algebraic assembly relation. -/
def stepRelation (n : ℕ) (r : Fin n → ℝ≥0) (p : MvPolynomial (Fin n) ℝ) (s t : ℝ≥0)
    (hrs : ∀ i, r i ≤ s) (hst : s ≤ t) : transportRelation :=
  ⟨(productTensor (intervalVector s t) (pastCoefficient r p),
    scalarTensor (incrementDirection s t) (pastCoefficient r p)),
    Submodule.subset_span ⟨n, r, p, s, t, hrs, hst, rfl⟩⟩

/-- The equivalence agrees with the concrete product-space and vector-space generator values. -/
theorem productToField_step (n : ℕ) (r : Fin n → ℝ≥0) (p : MvPolynomial (Fin n) ℝ)
    (s t : ℝ≥0) (hrs : ∀ i, r i ≤ s) (hst : s ≤ t) :
    (productToField (productAssembly (stepRelation n r p s t hrs hst)) : GaussianVectorL2) =
      scalarTensor (incrementDirection s t) (pastCoefficient r p) := by
  rw [productToField_assembly]
  rfl

/-- The actual isometric stochastic integral on the explicit product-space completion. -/
def productIntegral : closedProductSteps →ₗᵢ[ℝ] GaussianL2 :=
  completedIntegral.comp productToField.toLinearIsometry

theorem productIntegral_norm (u : closedProductSteps) : ‖productIntegral u‖ = ‖u‖ :=
  productIntegral.norm_map u

/-- The transported field has genuine domain membership and the same full-adjoint value. -/
theorem productIntegral_hilbertDivergence_graph (u : closedProductSteps) :
    ((productToField u : GaussianVectorL2), productIntegral u) ∈ hilbertDivergence.graph :=
  completedIntegral_hilbertDivergence_graph (productToField u)

theorem productIntegral_step (n : ℕ) (r : Fin n → ℝ≥0) (p : MvPolynomial (Fin n) ℝ)
    (s t : ℝ≥0) (hrs : ∀ i, r i ≤ s) (hst : s ≤ t) :
    productIntegral (productAssembly (stepRelation n r p s t hrs hst)) =
      incrementProductL2 r p s t := by
  have h := productIntegral_hilbertDivergence_graph
    (productAssembly (stepRelation n r p s t hrs hst))
  rw [productToField_step] at h
  exact hilbertDivergence.mem_graph_snd_inj h
    (pastCoefficient_hilbertDivergence_graph r p s t hrs hst) rfl

/-- Every genuine full-adjoint divergence value is centered, by pairing against constant one. -/
theorem hilbertDivergence_graph_centered (u : GaussianVectorL2) (F : GaussianL2)
    (h : (u, F) ∈ hilbertDivergence.graph) :
    (∫ ω, F ω ∂gaussianProduct) = 0 := by
  have h1 : (gaussianOne, (0 : GaussianVectorL2)) ∈ closedCylindricalDerivative.graph := by
    simpa only [one_smul] using closedDerivative_constant_graph 1
  obtain ⟨v, hv, hδ⟩ := hilbertDivergence.mem_graph_iff.mp h
  obtain ⟨one, hOne, hD⟩ := closedCylindricalDerivative.mem_graph_iff.mp h1
  have hp := (closedCylindricalDerivative.adjoint_isFormalAdjoint
    closedCylindricalDerivative_dense_domain).symm one v
  change inner ℝ (closedCylindricalDerivative one) (v : GaussianVectorL2) =
    inner ℝ (one : GaussianL2) (hilbertDivergence v) at hp
  rw [hD, hδ, hOne, inner_zero_left, gaussianOne_inner_eq_integral] at hp
  exact hp.symm

theorem productIntegral_integrable (u : closedProductSteps) :
    Integrable (productIntegral u) gaussianProduct :=
  (Lp.memLp (productIntegral u)).integrable (by simp)

/-- The constructed completed integral has a genuine finite expectation equal to zero. -/
theorem productIntegral_centered (u : closedProductSteps) :
    (∫ ω, productIntegral u ω ∂gaussianProduct) = 0 :=
  hilbertDivergence_graph_centered _ _ (productIntegral_hilbertDivergence_graph u)

end OperatorDerivativeRewrite.Foundation.GaussianPredictableL2Completion
