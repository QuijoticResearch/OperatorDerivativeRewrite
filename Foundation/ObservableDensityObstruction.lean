import Foundation.ObservableDensityCriterion

/-! A proper source domain can have a trivial restriction to a nonzero
one-dimensional observable subspace. -/
noncomputable section

namespace OperatorDerivativeRewrite.Foundation.ObservableDensityObstruction
open ObservableRestriction

variable {H E : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- If a nonzero vector is outside the source domain, no nonzero scalar
multiple of it lies in the source domain. -/
theorem span_outside_domain (A : H →ₗ.[ℝ] E) (v : H)
    (hv : v ∉ A.domain) :
    A.domain ⊓ (ℝ ∙ v) = ⊥ := by
  apply le_antisymm _ bot_le
  intro x hx
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx.2
  by_cases ha : a = 0
  · simp [ha]
  · have hmem : v ∈ A.domain := by
      have hm := A.domain.smul_mem a⁻¹ hx.1
      simpa [smul_smul, inv_mul_cancel₀ ha] using hm
    exact (hv hmem).elim

/-- The maximal observable restriction to the line generated by an
out-of-domain vector has zero domain. -/
theorem restricted_line_domain_bot (A : H →ₗ.[ℝ] E) (v : H)
    (hv : v ∉ A.domain) :
    (derivative A (ℝ ∙ v)).domain = ⊥ := by
  apply le_antisymm _ bot_le
  intro f hf
  have hx : (f : H) ∈ A.domain ⊓ (ℝ ∙ v) :=
    ⟨(derivative_domain A (ℝ ∙ v) f).mp hf, f.property⟩
  have hzero : (f : H) = 0 := by
    have := (span_outside_domain A v hv).le hx
    simpa using this
  exact Subtype.ext hzero


/-- A proper source domain admits a nonzero one-dimensional observable
subspace on which the restricted domain is not dense, even if the source
domain itself happens to be dense. -/
theorem restricted_line_not_dense (A : H →ₗ.[ℝ] E) (v : H)
    (hv : v ∉ A.domain) :
    ¬ Dense ((derivative A (ℝ ∙ v)).domain : Set (ℝ ∙ v)) := by
  have hv0 : v ≠ 0 := by
    intro he
    exact hv (he ▸ A.domain.zero_mem)
  intro hd
  rw [restricted_line_domain_bot A v hv] at hd
  have ht := Submodule.dense_iff_topologicalClosure_eq_top.mp hd
  have hclosed : IsClosed ((⊥ : Submodule ℝ (ℝ ∙ v)) : Set (ℝ ∙ v)) := by
    simpa using (isClosed_singleton (x := (0 : ℝ ∙ v)))
  rw [hclosed.submodule_topologicalClosure_eq] at ht
  have hbot : (⊥ : Submodule ℝ (ℝ ∙ v)) = ⊤ := ht
  have hmem : (⟨v, Submodule.mem_span_singleton_self v⟩ : ℝ ∙ v) ∈
      (⊥ : Submodule ℝ (ℝ ∙ v)) := hbot.symm ▸ Submodule.mem_top
  have : v = 0 := by simpa using hmem
  exact hv0 this

/-- A dense but proper source domain always admits a closed one-dimensional
observable subspace with nondense restricted domain. Source density alone
therefore has no abstract transfer theorem. -/
theorem exists_nondense_restriction_of_proper_domain
    (A : H →ₗ.[ℝ] E)
    (_hDense : Dense (A.domain : Set H))
    (hproper : A.domain ≠ ⊤) :
    ∃ V : Submodule ℝ H, V ≠ ⊥ ∧
      ¬ Dense ((derivative A V).domain : Set V) := by
  have hex : ∃ v : H, v ∉ A.domain := by
    by_contra hn
    push Not at hn
    apply hproper
    ext x
    simp [hn x]
  obtain ⟨v, hv⟩ := hex
  have hv0 : v ≠ 0 := by
    intro he
    exact hv (he ▸ A.domain.zero_mem)
  refine ⟨ℝ ∙ v, ?_, restricted_line_not_dense A v hv⟩
  simpa only [Submodule.span_singleton_eq_bot, ne_eq] using hv0
end OperatorDerivativeRewrite.Foundation.ObservableDensityObstruction

