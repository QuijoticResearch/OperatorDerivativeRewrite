import Foundation.FiniteGaussianObservationDensity
import Foundation.GaussianTimeDivergence

/-! Density for finite observations of the actual Gaussian time process.
This is distinct from density in the full Brownian past. -/
noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal Topology NNReal
namespace OperatorDerivativeRewrite.Foundation.GaussianTimeObservationDensity
open InfiniteGaussian GaussianTimeProcess GaussianTimeDivergence GaussianTimeHilbert
open SeparableHilbertEmbedding
attribute [local instance] timeHilbert_secondCountable

/-- The actual sigma-algebra generated by the specified time observations. -/
abbrev observationSigma {ι : Type*} (r : ι → ℝ≥0) : MeasurableSpace SampleSpace :=
  MeasurableSpace.comap (fun ω i => process (r i) ω) inferInstance

/-- Approximate every class measurable in a finite observation sigma-algebra
by a polynomial in those SAME observations. No distinctness or positive-time
condition is imposed. -/
theorem exists_observationPolynomial_approx {ι : Type*} [Fintype ι]
    (r : ι → ℝ≥0) (F : GaussianL2)
    (hF : AEStronglyMeasurable[observationSigma r] F gaussianProduct)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ p : MvPolynomial ι ℝ, ‖F - (pastCoefficient r p : GaussianL2)‖ < ε :=
  exists_isonormalPolynomial_approx
    (fun i => hilbertEmbedding TimeHilbert (timeVector (r i))) F hF ε hε

/-- Exact closure in ambient L2 equals the independently defined measurable
subspace, also for degenerate covariance and zero/empty observations. -/
theorem observationPolynomial_closure {ι : Type*} [Fintype ι] (r : ι → ℝ≥0) :
    closure (Set.range (fun p : MvPolynomial ι ℝ => (pastCoefficient r p : GaussianL2))) =
      (lpMeas ℝ ℝ (observationSigma r) 2 gaussianProduct : Set GaussianL2) :=
  isonormalPolynomial_closure (fun i => hilbertEmbedding TimeHilbert (timeVector (r i)))

/-- Observations at or before s generate a sub-sigma-algebra of the genuine
raw natural filtration. This does not assert density in the entire past. -/
theorem observationSigma_le_natural {ι : Type*} (s : ℝ≥0) (r : ι → Set.Iic s) :
    observationSigma (fun i => (r i : ℝ≥0)) ≤ naturalFiltration s := by
  apply Measurable.comap_le
  change @Measurable SampleSpace (ι → ℝ) (naturalFiltration s) _ _
  let : MeasurableSpace SampleSpace := naturalFiltration s
  apply Measurable.of_eval
  intro i
  exact ((process_stronglyAdapted (r i)).mono
    (naturalFiltration.mono (r i).property)).measurable

end OperatorDerivativeRewrite.Foundation.GaussianTimeObservationDensity
