import Foundation.IBMIntrinsicMartingaleEndpoint
import Foundation.GaussianPredictableStep

/-! Actual predictable time processes for intrinsic IBM stochastic steps.
The observation filtration is generated by IBM, while the integrator is M. -/
noncomputable section
open MeasureTheory Filter Set
open scoped NNReal Topology
namespace OperatorDerivativeRewrite.Foundation.IBMIntrinsicPredictableProcess
open IBMNaturalFiltrationObstruction IBMTimeAveragedObservable
open IBMIntrinsicMartingaleStep IBMIntrinsicMartingaleGrid
set_option backward.isDefEq.respectTransparency false

def timeStep (s t : ℝ≥0) (a : Coefficient s) (r : ℝ≥0) (ω : IBMSourceLaws.JointSample) : ℝ :=
  (Ioc s t).indicator (fun _ => a.function ω) r

theorem coefficient_factorization (s : ℝ≥0) (a : Coefficient s) :
    ∃ b : (Iic s → ℝ) → ℝ, Measurable b ∧ a.function =
      GaussianPredictableStep.pastCoefficient IBMConstructedSources.ibmValue s b := by
  exact (GaussianPredictableStep.measurable_natural_iff_exists_pastCoefficient
    (fun t => (point_stronglyMeasurable t).measurable) s a.function).mp a.adapted.measurable

theorem timeStep_predictable (s t : ℝ≥0) (a : Coefficient s) :
    IsStronglyPredictable naturalFiltration (timeStep s t a) := by
  obtain ⟨b, hb, he⟩ := coefficient_factorization s a
  have hp := GaussianPredictableStep.stepProcess_stronglyPredictable
    (fun t => (point_stronglyMeasurable t).measurable) s t hb
  have hf : timeStep s t a = GaussianPredictableStep.stepProcess IBMConstructedSources.ibmValue s t b := by
    funext r ω
    change (Ioc s t).indicator (fun _ => a.function ω) r = _
    rw [he]
    rfl
  rw [hf]
  exact hp

def timeSum (τ : ℕ → ℝ≥0) (a : ∀ i, Coefficient (τ i)) (n : ℕ)
    (r : ℝ≥0) (ω : IBMSourceLaws.JointSample) : ℝ :=
  ∑ i ∈ Finset.range n, timeStep (τ i) (τ (i + 1)) (a i) r ω

theorem timeSum_predictable (τ : ℕ → ℝ≥0) (a : ∀ i, Coefficient (τ i)) (n : ℕ) :
    IsStronglyPredictable naturalFiltration (timeSum τ a n) := by
  have hp (i : ℕ) := timeStep_predictable (τ i) (τ (i + 1)) (a i)
  change StronglyMeasurable[naturalFiltration.predictable]
    (fun z : ℝ≥0 × IBMSourceLaws.JointSample =>
      ∑ i ∈ Finset.range n, timeStep (τ i) (τ (i + 1)) (a i) z.1 z.2)
  exact Finset.stronglyMeasurable_fun_sum _ (fun i _ => hp i)

/-- A strict grid makes the actual coefficient recoverable at its right endpoint. -/
theorem timeSum_endpoint (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a : ∀ i, Coefficient (τ i)) (n i : ℕ) (hi : i < n) (ω : IBMSourceLaws.JointSample) :
    timeSum τ a n (τ (i + 1)) ω = (a i).function ω := by
  classical
  unfold timeSum
  rw [Finset.sum_eq_single i]
  · unfold timeStep
    exact Set.indicator_of_mem
      (show τ (i + 1) ∈ Ioc (τ i) (τ (i + 1)) from ⟨hτ (Nat.lt_succ_self i), le_rfl⟩) _
  · intro j hj hji
    apply indicator_of_notMem
    intro hm
    rcases lt_or_gt_of_ne hji with hji | hij
    · have he := hτ.monotone (Nat.succ_le_of_lt hji)
      exact (not_le_of_gt (hτ (Nat.lt_succ_self i))) (hm.2.trans he)
    · have he := hτ.monotone (Nat.succ_le_of_lt hij)
      exact (not_lt_of_ge he) hm.1
  · exact fun h => (h (Finset.mem_range.mpr hi)).elim

theorem coefficient_eq_of_timeSum_eq (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a b : ∀ i, Coefficient (τ i)) (n : ℕ) (he : timeSum τ a n = timeSum τ b n)
    {i : ℕ} (hi : i < n) : (a i).function = (b i).function := by
  funext ω
  have h := congrFun (congrFun he (τ (i + 1))) ω
  simpa only [timeSum_endpoint τ hτ a n i hi, timeSum_endpoint τ hτ b n i hi] using h

/-- Equality of actual time-dependent integrands forces equality of actual
stochastic sums on a common strict grid, independently of coefficient bounds. -/
theorem integral_eq_of_timeSum_eq (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a b : ∀ i, Coefficient (τ i)) (n : ℕ) (he : timeSum τ a n = timeSum τ b n) :
    IBMIntrinsicMartingaleGrid.sum τ a n = IBMIntrinsicMartingaleGrid.sum τ b n := by
  unfold IBMIntrinsicMartingaleGrid.sum
  apply Finset.sum_congr rfl
  intro i hi
  have hc := coefficient_eq_of_timeSum_eq τ hτ a b n he (Finset.mem_range.mp hi)
  exact congrArg (fun f => f * increment (τ i) (τ (i + 1))) hc

theorem integralClass_eq_of_timeSum_eq (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a b : ∀ i, Coefficient (τ i)) (n : ℕ) (he : timeSum τ a n = timeSum τ b n) :
    sumClass τ a n = sumClass τ b n := by
  apply Lp.ext
  exact (sumClass_ae τ a n).trans
    ((Filter.EventuallyEq.of_eq (integral_eq_of_timeSum_eq τ hτ a b n he)).trans (sumClass_ae τ b n).symm)

theorem timeStep_split {s u t : ℝ≥0} (hsu : s ≤ u) (hut : u ≤ t) (a : Coefficient s) :
    timeStep s u a + timeStep u t (IBMIntrinsicMartingaleRefinement.later hsu a) = timeStep s t a := by
  funext r ω
  have hd : Disjoint (Ioc s u) (Ioc u t) := Ioc_disjoint_Ioc_of_le le_rfl
  have he := congrFun (indicator_union_of_disjoint hd (fun _ => a.function ω)) r
  rw [Ioc_union_Ioc_eq_Ioc hsu hut] at he
  exact he.symm

theorem refined_timeSum (τ : ℕ → ℝ≥0) (hτ : Monotone τ)
    (a : Coefficient (τ 0)) (n : ℕ) :
    timeSum τ (IBMIntrinsicMartingaleRefinement.constantAlong τ hτ a) n = timeStep (τ 0) (τ n) a := by
  funext r ω
  induction n with
  | zero => simp [timeSum, timeStep]
  | succ n ih =>
    simp only [timeSum, Finset.sum_range_succ] at *
    rw [ih]
    exact congrFun (congrFun (timeStep_split (hτ (Nat.zero_le n)) (hτ (Nat.le_succ n)) a) r) ω

theorem coefficient_ae_of_timeSum_ae (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a b : ∀ i, Coefficient (τ i)) (n : ℕ)
    (he : ∀ r, timeSum τ a n r =ᵐ[IBMSourceLaws.jointMeasure] timeSum τ b n r)
    {i : ℕ} (hi : i < n) : (a i).function =ᵐ[IBMSourceLaws.jointMeasure] (b i).function := by
  filter_upwards [he (τ (i + 1))] with ω hh
  rw [timeSum_endpoint τ hτ a n i hi, timeSum_endpoint τ hτ b n i hi] at hh
  exact hh

/-- Almost-sure time-process equality on a common strict grid identifies the
actual stochastic integral, even when coefficient representatives differ. -/
theorem integralClass_eq_of_timeSum_ae (τ : ℕ → ℝ≥0) (hτ : StrictMono τ)
    (a b : ∀ i, Coefficient (τ i)) (n : ℕ)
    (he : ∀ r, timeSum τ a n r =ᵐ[IBMSourceLaws.jointMeasure] timeSum τ b n r) :
    sumClass τ a n = sumClass τ b n := by
  unfold sumClass
  apply Finset.sum_congr rfl
  intro i hi
  apply Lp.ext
  filter_upwards [stepClass_ae (τ i) (τ (i + 1)) (a i),
    stepClass_ae (τ i) (τ (i + 1)) (b i),
    coefficient_ae_of_timeSum_ae τ hτ a b n he (Finset.mem_range.mp hi)] with ω ha hb hc
  rw [ha, hb]
  simp only [step, Pi.mul_apply, hc]

end OperatorDerivativeRewrite.Foundation.IBMIntrinsicPredictableProcess
