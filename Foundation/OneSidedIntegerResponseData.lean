def linkValue (e : Fin 32 ⊕ Fin 80) (j : Fin 34) : ℤ :=
  Sum.elim (fun i => Xnum i j) (fun k => denominator*cycleData k j) e

theorem denominator_positive : 0<denominator := by decide

theorem response_sparse : ∀ r j,
    (∑ t : Fin 4, rowSign t*linkValue (rowLink r t) j)=Rnum r j := by
  decide +kernel

theorem normal_sparse : ∀ i j,
    (∑ t : Fin 6, normalSign i t*Rnum (normalIndex i t) j)=0 := by
  decide +kernel

theorem sparse_row_action (r : Fin 72) (a : Fin 32 → ℤ) (b : Fin 80 → ℤ) :
    (∑ i : Fin 32, Adata r i*a i)+(∑ k : Fin 80, Bdata r k*b k)=
      ∑ t : Fin 4, rowSign t*Sum.elim a b (rowLink r t) := by
  have ha : (∑ i : Fin 32, Adata r i*a i)=
      ∑ t : Fin 4, ∑ i : Fin 32, rowA r t i*a i := by
    simp_rw [A_sparse,Finset.sum_mul]
    rw [Finset.sum_comm]
  have hb : (∑ k : Fin 80, Bdata r k*b k)=
      ∑ t : Fin 4, ∑ k : Fin 80, rowB r t k*b k := by
    simp_rw [B_sparse,Finset.sum_mul]
    rw [Finset.sum_comm]
  rw [ha,hb,← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro t _
  cases ht : rowLink r t <;> simp [rowA,rowB,ht,ite_mul]

theorem response_equation (r : Fin 72) (j : Fin 34) :
    (∑ i : Fin 32, Adata r i*Xnum i j)+
      denominator*(∑ k : Fin 80, Bdata r k*cycleData k j)=Rnum r j := by
  have ht := sparse_row_action r (fun i => Xnum i j) (fun k => denominator*cycleData k j)
  change _=(∑ t : Fin 4, rowSign t*linkValue (rowLink r t) j) at ht
  rw [response_sparse] at ht
  calc
    _ = (∑ i : Fin 32, Adata r i*Xnum i j)+
        ∑ k : Fin 80, Bdata r k*(denominator*cycleData k j) := by
      rw [Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro k _
      ring
    _ = _ := ht

theorem normal_equation (i : Fin 32) (j : Fin 34) :
    (∑ r : Fin 72, Adata r i*Rnum r j)=0 := by
  calc
    _ = ∑ t : Fin 6, ∑ r : Fin 72,
        (if normalIndex i t=r then normalSign i t else 0)*Rnum r j := by
      simp_rw [A_column_sparse,Finset.sum_mul]
      rw [Finset.sum_comm]
    _ = ∑ t : Fin 6, normalSign i t*Rnum (normalIndex i t) j := by
      apply Finset.sum_congr rfl
      intro t _
      simp [ite_mul]
    _ = 0 := normal_sparse i j

end OperatorDerivativeRewrite.Foundation.OneSidedIntegerResponseData
