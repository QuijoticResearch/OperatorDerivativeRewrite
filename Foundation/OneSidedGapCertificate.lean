theorem point_number : ∀ e : Interior, point (number e)=e := by decide

theorem number_point : ∀ i : Fin 32, number (point i)=i := by decide

theorem number_injective : Function.Injective number :=
  Function.LeftInverse.injective point_number

def integerEntry (e f : Interior) : ℤ :=
  (∑ p : Inner, coefficient p e*coefficient p f)+
    ∑ p : Upper, upperCoefficient p e*upperCoefficient p f

theorem gram_entry_integer (e f : Interior) : gram e f=(integerEntry e f : ℝ) := by
  simp only [gram,Matrix.add_apply,Matrix.mul_apply,Matrix.transpose_apply,
    innerMatrix_entry,upperMatrix_entry,integerEntry,Int.cast_add,Int.cast_sum,Int.cast_mul]

theorem entries_checked : ∀ i j : Fin 32, Cdata i j=integerEntry (point i) (point j) := by decide

theorem gram_entry_Cdata (i j : Fin 32) : gram (point i) (point j)=(Cdata i j : ℝ) := by
  rw [gram_entry_integer,← entries_checked]

theorem gauge_checked : ∀ i : Fin 32, gdata i=(originStar (point i).val : ℚ) := by decide +kernel

theorem gauge_real (i : Fin 32) : (gdata i : ℝ)=gauge (point i) := by
  change (gdata i : ℝ)=(originStar (point i).val : ℝ)
  exact_mod_cast gauge_checked i

theorem pivots_nonnegative : ∀ k : Fin 32, 0≤Ddata k := by decide +kernel

