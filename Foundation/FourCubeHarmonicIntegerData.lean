def rawSource : Boundary → Fin 3 → ℤ
  | .inl c => if c.val=(capHigh chosen).val then ![1,0,0] else
      if c.val=(capLow chosen).val then ![0,0,-1] else 0
  | .inr p => if p.val=chosen.val then ![0,-1,0] else 0

theorem boundary_sources : ∀ (k : Fin 80) (a : Fin 3), rawSource (point k) a=Bnum k a := by
  intro k
  fin_cases k <;> decide +kernel

def linkValue (e : Fin 32 ⊕ Fin 80) (j : Fin 3) : ℤ :=
  Sum.elim (fun i => Xnum i j) (fun k => denominator*Bnum k j) e

theorem residual_sparse : ∀ (p : Fin 72) (j : Fin 3),
    (∑ t : Fin 4,rowSign t*linkValue (rowLink p t) j)=Rnum p j := by
  intro p
  fin_cases p <;> decide +kernel

theorem residual_equations (p : Fin 72) (j : Fin 3) :
    (∑ i : Fin 32,Adata p i*Xnum i j)+denominator*(∑ k : Fin 80,Bdata p k*Bnum k j)=Rnum p j := by
  have ht := OneSidedIntegerResponseData.sparse_row_action p (fun i => Xnum i j) (fun k => denominator*Bnum k j)
  change _=(∑ t : Fin 4,rowSign t*linkValue (rowLink p t) j) at ht
  rw [residual_sparse] at ht
  calc
    _ = (∑ i : Fin 32,Adata p i*Xnum i j)+∑ k : Fin 80,Bdata p k*(denominator*Bnum k j) := by
      rw [Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro k _
      ring
    _ = _ := ht

theorem normal_equations : ∀ (i : Fin 32) (j : Fin 3), (∑ p : Fin 72,Adata p i*Rnum p j)=0 := by
  decide +kernel

theorem pinned_row : Xnum 0=0 := by decide +kernel

