OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected : (ℝ → ℝ) → ℝ → ℝ
OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope : (ℝ → ℝ) → ℝ → ℝ
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.glue_zero : ∀ {F p n : ℝ → ℝ} {d : ℝ},
  HasDerivAt p d 0 → HasDerivAt n d 0 → (∀ (x : ℝ), 0 ≤ x → F x = p x) → (∀ x ≤ 0, F x = n x) → HasDerivAt F d 0
OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_pos : ∀ (f : ℝ → ℝ) {x : ℝ},
  0 ≤ x → OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f x = f x - x * deriv f 0
OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_neg : ∀ (f : ℝ → ℝ) {x : ℝ},
  x ≤ 0 → OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f x = f (-x) + x * deriv f 0
OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope_pos : ∀ (f : ℝ → ℝ) {x : ℝ},
  0 ≤ x → OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope f x = deriv f x - deriv f 0
OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope_neg : ∀ (f : ℝ → ℝ) {x : ℝ},
  x ≤ 0 → OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope f x = deriv f 0 - deriv f (-x)
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_hasDerivAt : ∀ {f : ℝ → ℝ},
  Differentiable ℝ f →
    ∀ (x : ℝ),
      HasDerivAt (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f)
        (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope f x) x
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope_hasDerivAt : ∀ {f : ℝ → ℝ},
  ContDiff ℝ 2 f →
    ∀ (x : ℝ), HasDerivAt (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope f) (deriv (deriv f) |x|) x
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_C2 : ∀ {f : ℝ → ℝ},
  ContDiff ℝ 2 f → ContDiff ℝ 2 (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f)
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_deriv : ∀ {f : ℝ → ℝ},
  Differentiable ℝ f →
    deriv (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f) =
      OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.slope f
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_second_deriv : ∀ {f : ℝ → ℝ},
  ContDiff ℝ 2 f →
    ∀ (x : ℝ),
      deriv (deriv (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f)) x = deriv (deriv f) |x|
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_deriv_bound : ∀ {f : ℝ → ℝ},
  Differentiable ℝ f →
    ∀ {C : ℝ},
      (∀ (x : ℝ), ‖deriv f x‖ ≤ C) →
        ∀ (x : ℝ), ‖deriv (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f) x‖ ≤ 2 * C
@OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected_second_deriv_bound : ∀ {f : ℝ → ℝ},
  ContDiff ℝ 2 f →
    ∀ {C : ℝ},
      (∀ (x : ℝ), ‖deriv (deriv f) x‖ ≤ C) →
        ∀ (x : ℝ), ‖deriv (deriv (OperatorDerivativeRewrite.Foundation.ReflectedC2Primitive.corrected f)) x‖ ≤ C
